<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestor de Cuentas</title>
    <meta name="version" content="0.2.0">
    <meta name="author" content="Respada">
    <meta name="reply-to" content="respada.pgr@gmail.com">
    <meta name="description" content="Lightweight web application for account management. Organize your credentials directly in your browser using local AES-GCM encryption. Without external data transfer.">
    <meta name="description" lang="es" content="Aplicación web ligera para la gestión de cuentas. Organice sus credenciales directamente en su navegador usando cifrado AES-GCM local. Sin transferencia de datos externa.">
    <meta name="description" lang="en" content="Lightweight web application for account management. Organize your credentials directly in your browser using local AES-GCM encryption. Without external data transfer.">

    <style>
        /* Variables CSS ---------------------------------------------------------------------------------------- */
        :root {
            --primary-color: #1276b9;
            --primary-hover-color: #0d729b;
            --secondary-color: #36db7b;
            --secondary-hover-color: #16aa54;
            --red-color: #e74c3c;
            --red-hover-color: #c72c1c;
            --dark-color: #1f1f20;
            --dark-hover-color: #101011;
            --background-color-body: #d3e4fc;
            --background-color-top: #839ffd;
            --background-color-main: #f9faff;
            --background-color-table-head: #ccc;
            --background-color-table-row-even: #f6fbfb;
            --background-color-table-row-odd: #ffffff;
            --background-color-table-row-selected: #f0f0f0;
            --border-color-input-text: #ccc;
            --border-color-table: #ccc;
            --box-sadow-color: rgba(0, 0, 0, 0.2);
            --font-color: #141414;
            --font-color-button: #fcfcfc;
            --font-color-table-row: #141414;
            --font-family: 'Arial', sans-serif;
            --font-size: 16px;
            --font-size-h1: 24px;
        }

        /* Modo Oscuro */
        @media (prefers-color-scheme: dark) {
            :root {
                --background-color-body: #2c353a;
                --background-color-main: #323d42;
                --box-sadow-color: rgba(0, 0, 0, 0.2);
                --font-color: #f5f5f5;
                --font-color-button: #fcfcfc;
                --font-color-table-row: #141414;
            }
        }

        /* ---------------------------------------------------------------------------------------------------------------------------- */
        /* Texto ---------------------------------------------------------------------------------------------------------------------- */
        /* Encabezado */
        h1 {
            text-align: center;
            font-size: var(--font-size-h1);
        }

        input {
            padding: 5px;
            border: 1px solid var(--border-color-input-text);
            border-radius: 2px;
            transition: border-color 0.3s;
            font-size: var(--font-size);
        }

            input:focus {
                border-color: var(--primary-color);
            }

        /* Botones ----------------------------------------------- */
        button, .btn, .btn-primary {
            margin: 3px;
            height: 26px;
            min-width: 26px;
            padding: 2px 5px;
            font-size: var(--font-size);
            border: none;
            border-radius: 3px;
            background-color: var(--primary-color);
            transition: background-color 0.3s;
            color: var(--font-color-button);
            cursor: pointer;
        }

            button:hover, .btn:hover, .btn-primary:hover {
                background-color: var(--primary-hover-color);
            }

            button.secondary, .btn-secondary {
                background-color: var(--secondary-color);
            }

                button.secondary:hover,
                .btn-secondary:hover {
                    background-color: var(--secondary-hover-color);
                }

            button.red, .btn-red {
                background-color: var(--red-color);
            }

                button.red:hover, .btn-red:hover {
                    background-color: var(--red-hover-color);
                }

            button.dark, .btn-dark {
                background-color: var(--dark-color);
            }

                button.dark:hover, .btn-dark:hover {
                    background-color: var(--dark-hover-color);
                }

            button * .emoji, .btn-emoji {
                display: inline-block;
                padding: 5px;
                cursor: pointer;
                /*user-select: none;  Evita la selección de texto al hacer clic */
            }

        /* Generales ------------------------------------------------------------------------------------------------------------------ */
        /* ---------------------------------------------------------------------------------------------------------------------------- */
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 4px;
            background-color: var(--background-color-body);
            color: var(--font-color);
            font-family: var(--font-family);
            font-size: var(--font-size);
        }

        /* Menu bar ------------------------------------------------------------------------------------------------------------------- */
        /* ---------------------------------------------------------------------------------------------------------------------------- */
        #containerMenuBar {
            z-index: 100;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: var(--background-color-top);
            box-shadow: 0 0 6px var(--box-sadow-color);
        }

            #containerMenuBar > div {
                margin: 0 auto;
                max-width: 1200px;
                min-width: 312px;
                padding: 0 5px;
            }

        /* Menu bar left -------------------------------------------------------------------------------------------------------------- */
        #buttonPanelMenuLeft {
            float: left;
            height: 40px;
            padding: 5px 2px 2px 2px;
        }
        /* Campo countdown ----------------------------------------------- */
        #fieldCountdown {
            display: inline-block;
        }

            #fieldCountdown #btnPauseCountdown,
            #fieldCountdown #btnStartCountdown {
                display: none;
            }

            #fieldCountdown.running #btnPauseCountdown,
            #fieldCountdown.running #btnResetCountdown {
                display: inline;
            }

            #fieldCountdown.paused #btnStartCountdown,
            #fieldCountdown.paused #btnResetCountdown {
                display: inline;
            }

            #fieldCountdown #txtCountdown {
                width: 69px;
                padding: 1px 1px 1px 2px;
            }

            #fieldCountdown button {
                margin: 0px;
                min-width: auto;
                border: none;
                padding: 0px;
                background-color: transparent;
                font-size: var(--font-size);
                cursor: pointer;
            }

        /* Menu bar right ------------------------------------------------------------------------------------------------------------- */
        #buttonPanelMenuRight {
            float: right;
            height: 40px;
            padding: 6px 2px 2px 2px;
        }

        /* Main container ------------------------------------------------------------------------------------------------------------- */
        /* ---------------------------------------------------------------------------------------------------------------------------- */
        #containerMain {
            margin: 5px auto 5px auto;
            max-width: 425px;
            min-width: 312px;
            padding: 4px;
        }

            #containerMain.opened {
                margin: 50px auto 5px auto;
            }

        /* Main menu container -------------------------------------------------------------------------------------------------------- */
        /* ---------------------------------------------------------------------------------------------------------------------------- */
        #containerMainMenu {
            margin: 10px auto 10px auto;
            max-width: 405px;
        }

        .containerMainMenuLine {
            min-height: 33px;
        }

        /* Decrypt Password ------------------------------------------------------------------------------------------------------------ */
        #containerDecryptPassword {
            display: inline-block;
            height: 33px;
        }

        #txtDecryptPassword {
            max-width: 130px;
        }

        /* Actions -------------------------------------------------------------------------------------------------------------------- */
        #containerActions {
            float: right;
            height: 33px;
            padding: 1px 0px;
        }

        /* Autosave ------------------------------------------------------------------------------------------------------------------- */
        #containerAutosave {
            margin-top: 6px;
        }

        #lblAutosave {
            display: block;
            float: left;
            margin: 1px;
            padding: 1px 2px 1px 10px;
        }

        #chkAutosave {
            display: block;
            float: left;
            margin: 3px 2px 3px 2px;
        }

        /* Tabla ---------------------------------------------------------------------------------------------------------------------- */
        #tblMain {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: var(--font-size);
            word-wrap: break-word;
        }

            #tblMain thead.header-large {
                display: table-header-group;
            }

            #tblMain thead.header-small {
                display: none;
            }

            #tblMain th {
                border: 1px solid var(--border-color-table);
                background-color: var(--background-color-table-head);
                /*padding: 5px;*/
                text-align: center;
            }

            #tblMain tr {
                min-height: 26px;
                color: var(--font-color-table-row);
            }

                #tblMain tr:nth-child(even) {
                    background-color: var(--background-color-table-row-even);
                }

                #tblMain tr:nth-child(odd) {
                    background-color: var(--background-color-table-row-odd);
                }

                #tblMain tr.selected {
                    background-color: var(--background-color-table-row-selected);
                }

                #tblMain tr.form-row {
                    display: none;
                }

            #tblMain td {
                border: 1px solid var(--border-color-table);
            }

                #tblMain td > div {
                    display: flex;
                    align-items: center;
                    padding: 5px;
                }

                    #tblMain td > div > span {
                        flex-wrap: wrap;
                        justify-content: center;
                        font-size: 12px;
                    }

                #tblMain td.multiline > div {
                    display: block;
                    width: 100%;
                    padding: 5px 0 0 5px;
                }

                    #tblMain td.multiline > div > div {
                        padding: 0 5px 5px 0;
                    }

                #tblMain td > div > span.field-label {
                    display: none;
                    padding-right: 5px;
                    font-weight: bold;
                }

            #tblMain input {
                width: 100%;
            }

            #tblMain tr.data-row input[readonly] {
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            #tblMain .buttonPanel {
                justify-content: center;
                align-items: center;
            }

            #tblMain .btnTogglePassword {
                margin-left: 5px;
            }

        /* Bottom container ----------------------------------------------------------------------------------------------------------- */
        /* ---------------------------------------------------------------------------------------------------------------------------- */
        #containerBottom {
            margin: 5px 0 5px 0;
            max-width: 425px;
            min-width: 312px;
            padding: 4px;
        }

        /* Legal Modal ----------------------------------------------------------------------------------------------------------- */
        /* ---------------------------------------------------------------------------------------------------------------------------- */
        #legalModal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.85);
            backdrop-filter: blur(4px);
        }

            #legalModal > div {
                margin: 5% auto;
                max-height: 80vh;
                max-width: 600px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.5);
                border-radius: 8px;
                overflow-y: auto;
                padding: 30px;
                background-color: var(--background-color-main);
                font-family: var(--font-family);
                text-align: justify;
            }

            #legalModal ul {
                font-size: 13px;
                color: var(--font-color);
                line-height: 1.4;
            }

            #legalModal li {
                padding: 3px;
            }

            #legalModal div.buttonPanel {
                text-align: center;
                margin-top: 20px;
            }

        #btnAcceptLegal {
            height: 40px;
            padding: 0 25px;
            font-weight: bold;
        }

        /* ---------------------------------------------------------------------------------------------------------------------------- */
        /* Responsivo ----------------------------------------------------------------------------------------------------------------- */
        /* Movil & Tablet Devices ----------------------------------------------------------------------------------------------------- */
        @media (max-width: 1024px) {
            #containerMain.editing::before {
                content: " ";
                display: block;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.5);
                z-index: 25;
            }

            #tblMain thead.header-large {
                display: none;
            }

            #tblMain thead.header-small {
                display: table-header-group;
            }

            #tblMain th,
            #tblMain td {
                display: block;
                width: 100% !important;
                position: relative;
            }

            #tblMain th {
                text-align: left;
            }

            #tblMain tr.form-row {
                display: none;
                position: fixed;
                top: 0;
                right: 0;
                z-index: 50;
                background-color: white;
                padding-top: 40px;
            }

            #tblMain td > div {
                justify-content: center;
            }

                #tblMain td > div > span.field-label {
                    display: inline;
                    overflow: initial;
                }

            #tblMain td.site-name {
                background-color: var(--background-color-table-head);
            }

            #tblMain td.only-laptop {
                display: none;
            }

            #tblMain #form-row.new #updateDateCell {
                display: none;
            }

            #tblMain #btnAddAccount {
                display: none;
            }

            #containerMenuBarBottom {
                display: none;
            }
        }

        /* Movil Devices -------------------------------------------------------------------------------------------------------------- */
        @media (max-width: 767px) {
            #containerMain {
                padding: 2px;
            }

            #containerBottom {
                margin: 10px 0 5px 0;
                padding: 2px;
            }

            /* Encabezado */
            h1 {
                text-align: center;
            }

            .right button {
                margin-left: 5px;
                margin-right: 0px;
            }
        }

        /* Small Movil Devices-------------------------------------------------------------------------------------------------------- */
        @media (max-width: 319px) {
            body {
                padding: 0 4px;
            }

            #containerMain {
                box-shadow: none;
            }

                #containerMain.opened {
                    margin: 80px auto 5px auto;
                }

            #containerActions {
                float: none;
                height: 33px;
            }
        }

        @media (max-width: 351px) {
            #containerMain.opened {
                margin: 90px auto 5px auto;
            }
        }

        /*M --------------------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 320px) {
            body {
                padding: 0 4px;
            }

            .container, #containerMain, #containerBottom {
                box-shadow: 0 0 4px var(--box-sadow-color);
                background-color: var(--background-color-main);
                padding: 4px;
            }
        }

        /* L -------------------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 375px) {
            body {
                padding: 0 8px;
            }

            .container, #containerMain, #containerBottom {
                box-shadow: 0 0 5px var(--box-sadow-color);
                padding: 8px;
            }
        }

        /*Tablet ---------------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 768px) {
            body {
                padding: 0 10px;
            }

            /* Capas contenedoras */
            .container, #containerMain, #containerBottom {
                margin: 10px auto;
                box-shadow: 0 0 7px var(--box-sadow-color);
                padding: 10px;
            }

            #containerActions {
                display: inline-block;
            }
        }

        /*Tablet rotated -------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 777px) {
            body {
                padding: 0 12px;
            }

            .container, #containerMain, #containerBottom {
                margin: 12px auto;
                box-shadow: 0 0 10px var(--box-sadow-color);
                padding: 12px;
            }
        }

        /*Desk ------------------------------------------------------------------------------------------------------------------------ */
        @media (min-width: 865px) {
            :root {
                --font-size: 14px;
            }

            #containerMain, #containerBottom {
                padding: 16px;
            }

            #containerMainMenu {
                margin-bottom: 15px;
            }

            .containerMainMenuLine {
                min-height: 51px;
                box-shadow: 0 0 10px var(--box-sadow-color);
                padding: 10px;
            }

            #containerDecryptPassword, #containerActions {
                height: 31px;
            }
        }

        /*Laptop ---------------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 1024px) {
            #containerMain, #containerBottom {
                padding: 20px;
                max-width: 1440px;
                min-width: 1024px;
            }

            #fieldCountdown #txtCountdown {
                width: 60px;
            }

            #containerMenuBarBottom {
                display: block;
                margin-top: 10px;
                height: 31px;
            }
        }

        /*Laptop L -------------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 1440px) {
        }

        /*Laptop 4K ------------------------------------------------------------------------------------------------------------------- */
        @media (min-width: 2560px) {
        }

        /* ---------------------------------------------------------------------------------------------------------------------------- */
        /* Important ------------------------------------------------------------------------------------------------------------------ */
        .hidden {
            display: none !important;
        }

        .right {
            float: right !important;
        }
    </style>
</head>

<body class="hidden">
    <div id="containerMenuBar" class="hidden">
        <div>
            <div id="buttonPanelMenuLeft">
                <button id="btnClose" type="button" title="Cerrar" class="btn-red" onclick="handleCloseForm()">X</button>
                <div id="fieldCountdown">
                    <input id="txtCountdown" type="text" value="00:05:00" />
                    <button id="btnStartCountdown">▶️</button>
                    <button id="btnPauseCountdown">⏸️</button>
                    <button id="btnResetCountdown">🔄</button>
                </div>
                <button id="btnSave" type="button" title="Guardar" class="btn-secondary hidden" aria-label="Guardar en fichero">Guardar</button>
            </div>
            <div id="buttonPanelMenuRight">
                <button id="btnAddAccountTop" type="button" title="Nuevo">+</button>
                <button id="btnMoveAccountUp" type="button" class="right">↑</button>
                <button id="btnMoveAccountDown" type="button" class="right">↓</button>
            </div>
        </div>
    </div>
    <div id="containerMain">
        <div id="containerMainMenu">
            <h1>Gestión de cuentas</h1>
            <div class="containerMainMenuLine">
                <div id="containerDecryptPassword">
                    <input id="txtDecryptPassword" type="password" placeholder="Contraseña" aria-label="Contraseña de Desencriptación" />
                    <span id="btnToggleDecryptPassword" title="Mostrar/Ocultar Contraseña" class="btn-emoji" aria-label="Mostrar/Ocultar Contraseña">👁️</span>
                    <span id="btnChangeDecryptPassword" type="button" title="Cambiar contraseña encriptación" class="btn-emoji hidden" aria-label="Cambiar contraseña encriptación">💾</span>
                    <button id="btnNext" type="button" title="Siguiente">></button>
                </div>
                <input id="inputLoadFile" type="file" class="hidden" accept=".gdc" />

                <div id="containerActions">
                    <button id="btnLoad" type="button" title="Cargar fichero" class="btn-secondary right" aria-label="Cargar fichero">Cargar</button>
                    <button id="btnNewDecryptPassword" type="button" title="Nuevo" class="btn-dark right" aria-label="Nuevo fichero">Nuevo</button>
                    <div id="containerAutosave" class="autosave-field right hidden">
                        <label id="lblAutosave" for="chkAutosave">Autosave</label>
                        <input id="chkAutosave" type="checkbox" checked />
                    </div>
                </div>
            </div>
        </div>
        <div id="containerTableMain" class="hidden">
            <table id="tblMain">
                <thead class="header-large">
                    <tr>
                        <th style="width: 0%;  min-width: 0px" class="hidden"></th>
                        <th style="width: 17%; min-width: 170px">Sitio</th>
                        <th style="width: 16%; min-width: 160px">Usuario</th>
                        <th style="width: 18%; min-width: 180px">Password</th>
                        <th style="width: 22%; min-width: 220px">Notas</th>
                        <th style="width: 9%; min-width: 90px" class="only-laptop">Creación</th>
                        <th style="width: 9%; min-width: 90px">Actualiz.</th>
                        <th style="width: 8%;  min-width: 80px"></th>
                    </tr>
                </thead>
                <thead class="header-small">
                    <tr>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="form-row" class="form-row">
                        <td class="hidden">
                            <div>
                                <input type="text" id="f-id" placeholder="Id" aria-label="Id" readonly />
                            </div>
                        </td>
                        <td class="multiline">
                            <div>
                                <div style="flex: 3 1 100px">
                                    <input type="text" id="f-name" placeholder="Sitio" aria-label="Nombre del Sitio" />
                                </div>
                                <div style="flex: 9 1 100px">
                                    <input type="url" id="f-url" placeholder="Url" required aria-label="URL del Sitio" />
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>
                                <input type="text" id="f-user" placeholder="Usuario" aria-label="Usuario" />
                            </div>
                        </td>
                        <td>
                            <div>
                                <input type="password" id="f-password" class="encrypted-password" placeholder="Password"
                                       aria-label="Contraseña" />
                                <span class="btnTogglePassword btn-emoji">👁️</span>
                            </div>
                        </td>
                        <td>
                            <div>
                                <input type="text" id="f-notes" placeholder="Notas" aria-label="Notas" />
                            </div>
                        </td>
                        <td class="only-laptop">
                            <div>
                                <input type="text" id="f-createDate" placeholder="Fecha de Creación" disabled
                                       aria-label="Fecha de Creación" readonly />
                            </div>
                        </td>
                        <td id="updateDateCell">
                            <div>
                                <input type="text" id="f-updateDate" placeholder="Fecha de Actualización" disabled
                                       aria-label="Fecha de Actualización" readonly />
                            </div>
                        </td>
                        <td>
                            <div class="buttonPanel">
                                <button type="button" id="save-button" title="Guardar" class="btn btn-primary">
                                    💾
                                </button>
                                <button type="button" id="cancel-button" title="Cancelar" class="btn btn-dark">
                                    ❌
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
            <div id="containerMenuBarBottom">
                <button id="btnAddAccount" class="right">Añadir</button>
            </div>
        </div>
    </div>
    <div id="containerBottom" class="hidden">
        -
    </div>

    <div id="legalModal">
        <div>

            <div style="border-bottom: 2px solid var(--red-color); margin-bottom: 20px;">
                <h2 style="margin-top:0; color: var(--red-color);">⚠️ Aviso Legal / Legal Disclaimer</h2>
            </div>

            <div style="margin-bottom: 10px;">
                <p><strong>Español:</strong> Este es un proyecto amateur con fines educativos. Al usarlo, usted acepta que:</p>
                <ul>
                    <li><strong>Cifrado Local:</strong> Los datos se cifran en su navegador. Si olvida su contraseña, <strong>no hay forma de recuperar los datos</strong>.</li>
                    <li><strong>Almacenamiento local:</strong> Esta aplicación utiliza el almacenamiento local del navegador. Si limpia los datos del navegador, usa el modo incógnito o cambia de ordenador, <strong>perderá tus datos</strong>. Guarde una copia de seguridad en fichero en su ordenador pulsando el botón <strong>Guardar</strong>.</li>
                    <li><strong>Sin Responsabilidad:</strong> El autor no se hace responsable de pérdidas de información, hackeos locales o fallos del software.</li>
                    <li><strong>Uso:</strong> Se proporciona "tal cual" (as-is), sin garantías de seguridad absoluta.</li>
                </ul>
            </div>

            <hr style="border: 0; border-top: 1px solid var(--border-color-table); margin: 20px 0;">

            <div style="margin-bottom: 10px;">
                <p><strong>English:</strong> This is an amateur project for educational purposes. By using it, you agree that:</p>
                <ul>
                    <li><strong>Local Encryption:</strong> Data is encrypted in your browser. If you forget your password, <strong>data recovery is impossible</strong>.</li>
                    <li><strong>Local Storage:</strong> This application uses your browser's local storage. If you clear your browser data, use incognito status, or switch computers, <strong>you will lose your data</strong>. Save a backup copy to a file on your computer by clicking the <strong>Save</strong> button.</li>
                    <li><strong>No Liability:</strong> The author is not responsible for data loss, local security breaches, or software failures.</li>
                    <li><strong>Usage:</strong> Provided "as-is", without any warranties regarding absolute security.</li>
                </ul>
            </div>

            <div class="buttonPanel">
                <button id="btnAcceptLegal" class="btn-primary">Entiendo y Acepto / I Understand & Accept</button>
            </div>
        </div>
    </div>

    <script>

        class URLManager {
            static ensureProtocol(url) {
                if (!/^https?:\/\//i.test(url)) {
                    return "https://" + url;
                }
                return url;
            }
        }

        class TimeManager {
            // Return total seconds from a time string in format "hh:mm:ss"
            static toSeconds(timeString) {
                const [h, m, s] = timeString.split(":").map(Number);
                if (!isNaN(h) && !isNaN(m) && !isNaN(s)) {
                    return h * 3600 + m * 60 + s;
                } else {
                    return null;
                }
            }

            static format(seconds) {
                const h = String(Math.floor(seconds / 3600)).padStart(2, "0");
                const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, "0");
                const s = String(seconds % 60).padStart(2, "0");
                return `${h}:${m}:${s}`;
            }
        }

        class DateManager {
            static getCurrentDateString() {
                const now = new Date();
                const hours = now.getHours().toString().padStart(2, "0");
                const minutes = now.getMinutes().toString().padStart(2, "0");
                const seconds = now.getSeconds().toString().padStart(2, "0");
                const day = now.getDate().toString().padStart(2, "0");
                const month = (now.getMonth() + 1).toString().padStart(2, "0"); // Los meses en JavaScript son 0-indexados
                const year = now.getFullYear();

                const formattedDate = `${day}/${month}/${year} ${hours}:${minutes}:${seconds}`;
                return formattedDate;
            }

            static getFormattedCurrentDateString() {
                const now = new Date();
                const formattedDate = `${now.getFullYear()}${(now.getMonth() + 1)
                    .toString()
                    .padStart(2, "0")}${now.getDate().toString().padStart(2, "0")}_${now
                        .getHours()
                        .toString()
                        .padStart(2, "0")}${now.getMinutes().toString().padStart(2, "0")}${now
                            .getSeconds()
                            .toString()
                            .padStart(2, "0")}`;
                return formattedDate;
            }
        }

        class AlertManager {
            static show(message) {
                alert(message);
            }

            static showMessage(message) {
                alert("GDC:\n" + message);
            }

            static showSuccess(message) {
                alert("¡ÉXITO! GDC:\n" + message);
            }

            static showWarning(message) {
                alert("¡ATENCIÓN! GDC:\n" + message);
            }

            static showError(message) {
                alert("¡ERROR! GDC:\n" + message);
            }

            static showException(exception) {
                if (typeof exception === "string") {
                    alert("¡EXCEPCIÓN! GDC: \n" + exception);
                }
                else if (exception instanceof Error) {
                    alert("¡EXCEPCIÓN! GDC:\n" + exception.message);
                }
                else {
                    throw new Error("AlertManager.showException: Unsupported exception type");
                }
            }
        }

        class ConfirmManager {
            static confirm(message) {
                return confirm("GDC:\n" + message);
            }
        }

        class ConsoleManager {
            static addLog(text) {
                console.log(DateManager.getCurrentDateString() + "> GDC: " + text);
            }

            static addWarn(text) {
                console.warn(DateManager.getCurrentDateString() + "> GDC: " + text);
            }

            static addError(text) {
                console.error(DateManager.getCurrentDateString() + "> GDC Error: " + text);
            }
        }

        class StringManager {

            //Oculta visualmente un texto reemplazando cada caracter por un asterisco (*)
            static maskText(text) {
                if (text) return text.replace(/./g, "*");
                else return "";
            }

            // Método privado/auxiliar para aplicar la clave secreta
            static _xor(text, key) {
                if (!key) return text;
                let result = '';
                for (let i = 0; i < text.length; i++) {
                    result += String.fromCharCode(text.charCodeAt(i) ^ key.charCodeAt(i % key.length));
                }
                return result;
            }

            // Codifica a Base64 nativo
            static toBase64(str) {
                return btoa(unescape(encodeURIComponent(str)));
            }

            // Decodifica desde Base64 nativo
            static fromBase64(str) {
                return decodeURIComponent(escape(atob(str)));
            }

            static encrypt(text, key) {
                if (!text) return "";
                const obfuscated = this._xor(text, key);
                return this.toBase64(obfuscated);
            }

            static decrypt(cipherText, key) {
                if (!cipherText) return "";
                const obfuscated = this.fromBase64(cipherText);
                return this._xor(obfuscated, key);
            }

            //Genera un hash de 8 caracteres basado en el algoritmo DJB2, a partir de un texto.
            static toHash(str) {
                if (!str) return "";

                let hash = 5381; // Número primo inicial (Semilla estándar del algoritmo DJB2)

                for (let i = 0; i < str.length; i++) {
                    // Operación matemática síncrona de bits (Bitwise) para mezclar los caracteres
                    hash = (hash * 33) ^ str.charCodeAt(i);
                }

                // >>> 0 convierte el resultado a un número entero sin signo de 32 bits
                // .toString(16) lo transforma en una cadena hexadecimal (ej: "4b2f8a1c")
                return (hash >>> 0).toString(16);
            }

            //Genera una contraseña aleatoria de forma síncrona y criptográficamente segura.
            static generatePassword(length = 12) {
                // Banco de caracteres permitidos (letras mayúsculas, minúsculas, números y símbolos)
                const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+~`|}{[]:;?><,./-=";
                let password = "";

                // Creamos un array de números enteros sin signo de 32 bits, uno por cada carácter que necesitamos
                const randomValues = new Uint32Array(length);

                // Llenamos el array con números aleatorios criptográficos de forma SÍNCRONA
                window.crypto.getRandomValues(randomValues);

                for (let i = 0; i < length; i++) {
                    // Usamos el residuo (%) para asegurarnos de que el número caiga dentro del rango de nuestro charset
                    const randomIndex = randomValues[i] % charset.length;
                    password += charset[randomIndex];
                }

                return password;
            }
        }

        class HtmlManager {

            static existElementById(id) {
                if (!id) {
                    ConsoleManager.addWarn("HtmlManager.existElementById: ID is null or undefined.");
                    return false;
                }
                return document.getElementById(id) !== null;
            }

            static getElementById(id) {
                if (!id) {
                    ConsoleManager.addWarn("HtmlManager.getElementById: ID is null or undefined.");
                    return null;
                }
                return document.getElementById(id);
            }

            static getElementByQuerySelector(query) {
                if (!query) {
                    ConsoleManager.addWarn("HtmlManager.getElementByQuerySelector: Query selector is null or undefined.");
                    return null;
                }
                return document.querySelector(query);
            }

            static getChildBySelector(target, query) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.getChildBySelector: Target element is null or undefined.");
                    return null;
                }
                if (!query) {
                    ConsoleManager.addWarn("HtmlManager.getChildBySelector: Query selector is null or undefined.");
                    return null;
                }
                return target.querySelector(query);
            }

            static getValue(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.getValue: Target element is null or undefined.");
                    return "";
                }
                return target.value !== undefined ? target.value : "";
            }

            static setValue(target, value) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.setValue: Target element is null or undefined.");
                    return;
                }
                target.value = value;
            }

            static getText(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.getText: Target element is null or undefined.");
                    return "";
                }
                return target.textContent || "";
            }

            static setText(target, text) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.setText: Target element is null or undefined.");
                    return;
                }
                target.textContent = text;
            }

            static getAttr(target, name) {
                if (!target) {
                    ConsoleManager.addWarn(`HtmlManager.getAttr: Target element is null or undefined.`);
                    return null;
                }
                return target.getAttribute(name);
            }

            static setAttr(target, name, value) {
                if (!target) {
                    ConsoleManager.addWarn(`HtmlManager.setAttr: Target element is null or undefined.`);
                    return;
                }
                target.setAttribute(name, value);
            }

            static getChecked(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.getChecked: Target element is null or undefined.");
                    return false;
                }
                return !!target.checked;
            }

            static setChecked(target, isChecked) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.setChecked: Target element is null or undefined.");
                    return;
                }
                target.checked = isChecked;
            }

            static getDisabled(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.getDisabled: Target element is null or undefined.");
                    return false;
                }
                return !!target.disabled;
            }

            static setDisabled(target, isDisabled) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.setDisabled: Target element is null or undefined.");
                    return;
                }
                target.disabled = isDisabled;
            }

            static containsClass(target, className) {
                if (!target) {
                    ConsoleManager.addWarn(`HtmlManager.containsClass: Target element is null or undefined.`);
                    return false;
                }
                return target.classList.contains(className);
            }

            static addClass(target, className) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.addClass: Target element is null or undefined.");
                    return;
                }
                target.classList.add(className);
            }

            static removeClass(target, className) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.removeClass: Target element is null or undefined.");
                    return;
                }
                target.classList.remove(className);
            }

            static toggleClass(target, className) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.toggleClass: Target element is null or undefined.");
                    return;
                }
                target.classList.toggle(className);
            }

            static hide(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.hide: Target element is null or undefined.");
                    return;
                }
                this.addClass(target, "hidden");
            }

            static show(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.show: Target element is null or undefined.");
                    return;
                }
                this.removeClass(target, "hidden");
            }

            static toggleShow(target) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.toggleShow: Target element is null or undefined.");
                    return;
                }
                this.toggleClass(target, "hidden");
            }

            static setInnerHTML(target, content) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.setInnerHTML: Target element is null or undefined.");
                    return;
                }
                target.innerHTML = content;
            }

            // Agrega un nuevo elemento hijo al principio del elemento objetivo
            static prependChild(target, child) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.prependChild: Target element is null or undefined.");
                    return;
                }
                target.prepend(child);
            }

            static appendChild(target, child) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.appendChild: Target element is null or undefined.");
                    return;
                }
                target.appendChild(child);
            }

            static replaceElement(target, newElement) {
                if (!target) {
                    ConsoleManager.addWarn("HtmlManager.replaceElement: Target element is null or undefined.");
                    return;
                }
                if (!newElement) {
                    ConsoleManager.addWarn("HtmlManager.replaceElement: New element is null or undefined.");
                    return;
                }
                target.replaceWith(newElement);
            }

            static addEvent(target, eventType, callback) {
                if (!target) {
                    ConsoleManager.addWarn(`HtmlManager.addEvent: Cannot listen to "${eventType}". Target element is null or undefined.`);
                    return;
                }
                target.addEventListener(eventType, callback);
            }
        }

        class HtmlBase {
            static Control = class {
                constructor(id) {
                    this.id = id;
                }

                get element() {
                    const result = HtmlManager.getElementById(this.id);
                    if (!result) {
                        throw new Error("HtmlBase.Control: Element with ID '" + this.id + "' not found.");
                    }
                    return result;
                }

                replaceWith(newControl) {
                    // Si nos pasan otra instancia de nuestra arquitectura, extraemos su elemento nativo
                    const newEl = newControl instanceof HtmlBase.Control ? newControl.element : newControl;

                    HtmlManager.replaceElement(this.element, newEl);
                    return this;
                }

                addClass(className) {
                    HtmlManager.addClass(this.element, className);
                    return this;
                }

                removeClass(className) {
                    HtmlManager.removeClass(this.element, className);
                    return this;
                }

                toggleClass(className) {
                    HtmlManager.toggleClass(this.element, className);
                    return this;
                }

                show() {
                    HtmlManager.show(this.element);
                    return this;
                }

                hide() {
                    HtmlManager.hide(this.element);
                    return this;
                }

                toggleShow() {
                    HtmlManager.toggleShow(this.element);
                    return this;
                }

                getAttr(name) {
                    return HtmlManager.getAttr(this.element, name);
                }

                setAttr(name, value) {
                    HtmlManager.setAttr(this.element, name, value);
                    return this;
                }

                on(eventType, callback) {
                    HtmlManager.addEvent(this.element, eventType, callback);
                    return this;
                }

                onClick(callback) { return this.on("click", callback); }
                onDblClick(callback) { return this.on("dblclick", callback); }
                onContextMenu(callback) { return this.on("contextmenu", callback); }
                onMouseEnter(callback) { return this.on("mouseenter", callback); }
                onMouseLeave(callback) { return this.on("mouseleave", callback); }
                onMouseMove(callback) { return this.on("mousemove", callback); }
                onKeyDown(callback) { return this.on("keydown", callback); }
                onKeyUp(callback) { return this.on("keyup", callback); }
                onFocus(callback) { return this.on("focus", callback); }
                onBlur(callback) { return this.on("blur", callback); }
            }

            static FormControl = class extends HtmlBase.Control {
                constructor(id) {
                    super(id);
                }

                get value() { return HtmlManager.getValue(this.element); }
                set value(newValue) { HtmlManager.setValue(this.element, newValue); }

                get disabled() { return HtmlManager.getDisabled(this.element); }
                set disabled(isDisabled) { HtmlManager.setDisabled(this.element, isDisabled); }

                setValue(newValue) {
                    HtmlManager.setValue(this.element, newValue);
                    return this;
                }

                setDisabled() {
                    this.disabled = true;
                    return this;
                }

                setEnabled() {
                    this.disabled = false;
                    return this;
                }

                onChange(callback) { return this.on("change", callback); }
                onInput(callback) { return this.on("input", callback); }
            }

            static ContainerControl = class extends HtmlBase.Control {
                constructor(id) {
                    super(id);
                }

                html(content) {
                    HtmlManager.setInnerHTML(this.element, content);
                    return this;
                }

                append(childElement) {
                    const el = childElement instanceof HtmlBase.Control ? childElement.element : childElement;
                    HtmlManager.appendChild(this.element, el);
                    return this;
                }

                clear() {
                    HtmlManager.setInnerHTML(this.element, "");
                    return this;
                }
            }

            static TextControl = class extends HtmlBase.Control {
                constructor(id) {
                    super(id);
                }
                get text() {
                    return HtmlManager.getText(this.element);
                }

                set text(newText) {
                    HtmlManager.setText(this.element, newText);
                }

                setText(newText) {
                    HtmlManager.setText(this.element, newText);
                    return this;
                }
            }
        }

        class HtmlControls {
            // === CONTAINER CONTROLS ===
            static Div = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Span = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Section = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Article = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Main = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Header = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Footer = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Nav = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static Aside = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }

            static Form = class extends HtmlBase.ContainerControl {
                constructor(id) { super(id); }
                submit() { this.element.submit(); return this; }
                reset() { this.element.reset(); return this; }
            }

            static List = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }
            static ListItem = class extends HtmlBase.ContainerControl { constructor(id) { super(id); } }

            static Image = class extends HtmlBase.ContainerControl {
                constructor(id) { super(id); }
                setSrc(url) { HtmlManager.setAttr(this.element, "src", url); return this; }
                getSrc() { return HtmlManager.getAttr(this.element, "src") || ""; }
            }

            static Anchor = class extends HtmlBase.ContainerControl {
                constructor(id) { super(id); }
                setHref(url) { HtmlManager.setAttr(this.element, "href", url); return this; }
                getHref() { return HtmlManager.getAttr(this.element, "href") || ""; }
            }

            static Table = class extends HtmlBase.ContainerControl {
                constructor(id) { super(id); }

                get headElement() {
                    let thead = HtmlManager.getChildBySelector(this.element, 'thead');
                    if (!thead) throw new Error(`HtmlControls.Table.headElement: Table head element not found for ID '${this.id}'.`);
                    return thead;
                }

                get bodyElement() {
                    let tbody = HtmlManager.getChildBySelector(this.element, 'tbody');
                    if (!tbody) throw new Error(`HtmlControls.Table.bodyElement: Table body element not found for ID '${this.id}'.`);
                    return tbody;
                }

                get headRows() { return Array.from(this.headElement.querySelectorAll('tr')); }
                get bodyRows() { return Array.from(this.bodyElement.querySelectorAll('tr')); }

                create(parentElement, headersArray = null) {
                    if (!parentElement) throw new Error("HtmlControls.Table.create: Parent element is null or undefined.");

                    let table = HtmlManager.getElementById(this.id);
                    if (table) throw new Error(`HtmlControls.Table.create: Table element with ID '${this.id}' already exists in the DOM.`);

                    table = document.createElement('table');
                    table.id = this.id;

                    const thead = document.createElement('thead');
                    if (headersArray && Array.isArray(headersArray) && headersArray.length > 0) {
                        const tr = document.createElement('tr');
                        headersArray.forEach(text => {
                            const th = document.createElement('th');
                            HtmlManager.setText(th, text);
                            HtmlManager.appendChild(tr, th);
                        });
                        HtmlManager.appendChild(thead, tr);
                    }

                    HtmlManager.appendChild(table, thead);
                    HtmlManager.appendChild(table, document.createElement('tbody'));

                    const parentEl = parentElement instanceof HtmlBase.Control ? parentElement.element : parentElement;
                    HtmlManager.appendChild(parentEl, table);
                    return this;
                }

                addHead(headersArray) {
                    if (!headersArray || !Array.isArray(headersArray) || headersArray.length === 0)
                        throw new Error(`HtmlControls.Table.addHead: Expected a non-empty array of headers for ID '${this.id}'.`);

                    let thead = HtmlManager.getChildBySelector(this.element, 'thead');
                    if (thead) throw new Error(`HtmlControls.Table.addHead: Table head already exists for ID '${this.id}'.`);

                    const tr = document.createElement('tr');
                    headersArray.forEach(text => {
                        const th = document.createElement('th');
                        HtmlManager.setText(th, text);
                        HtmlManager.appendChild(tr, th);
                    });

                    thead = document.createElement('thead');
                    HtmlManager.appendChild(thead, tr);
                    HtmlManager.prependChild(this.element, thead);
                    return this;
                }

                addRow(htmlRow) {
                    if (!htmlRow) throw new Error("HtmlControls.Table.addRow: HTML row is null or undefined.");
                    HtmlManager.appendChild(this.bodyElement, htmlRow);
                    return this;
                }

                addDataRow(dataArray) {
                    if (!dataArray) throw new Error("HtmlControls.Table.addDataRow: Data array is null or undefined.");

                    const tr = document.createElement('tr');
                    if (Array.isArray(dataArray)) {
                        dataArray.forEach(text => {
                            const td = document.createElement('td');
                            HtmlManager.setText(td, text);
                            HtmlManager.appendChild(tr, td);
                        });
                    }
                    return this.addRow(tr);
                }

                addRows(htmlRowsArray) {
                    if (!htmlRowsArray || !Array.isArray(htmlRowsArray)) throw new Error("HtmlControls.Table.addRows: Expected an array of HTML rows.");
                    htmlRowsArray.forEach(row => this.addRow(row));
                    return this;
                }

                addDataRows(dataArrays) {
                    if (!dataArrays || !Array.isArray(dataArrays)) throw new Error("HtmlControls.Table.addDataRows: Expected an array of data arrays.");
                    dataArrays.forEach(dataArray => this.addDataRow(dataArray));
                    return this;
                }

                fill(htmlRowsArray) { this.clear(); return this.addRows(htmlRowsArray); }
                fillData(dataArrays) { this.clear(); return this.addDataRows(dataArrays); }
                clear() { HtmlManager.setInnerHTML(this.bodyElement, ""); return this; }
            }

            // === FORM CONTROLS ===
            static Button = class extends HtmlBase.FormControl { constructor(id) { super(id); } }
            static Input = class extends HtmlBase.FormControl { constructor(id) { super(id); } }
            static Select = class extends HtmlBase.FormControl { constructor(id) { super(id); } }
            static TextArea = class extends HtmlBase.FormControl { constructor(id) { super(id); } }

            static Checkbox = class extends HtmlBase.FormControl {
                constructor(id) { super(id); }
                setChecked(isChecked) { HtmlManager.setChecked(this.element, isChecked); return this; }
                getChecked() { return HtmlManager.getChecked(this.element); }
            }

            static Radio = class extends HtmlBase.FormControl {
                constructor(id) { super(id); }
                setChecked(isChecked) { HtmlManager.setChecked(this.element, isChecked); return this; }
                getChecked() { return HtmlManager.getChecked(this.element); }
            }

            // === TEXT CONTROLS ===
            static Heading = class extends HtmlBase.TextControl { constructor(id) { super(id); } }
            static Paragraph = class extends HtmlBase.TextControl { constructor(id) { super(id); } }
            static Label = class extends HtmlBase.TextControl { constructor(id) { super(id); } }
        }

        class GdcPageMng {
            static status = "";

            static showLoading() {
                document.body.style.cursor = "wait";
            }
            static hideLoading() {
                document.body.style.cursor = "default";
            }

            static get() {
                return document.body;
            }

            static show() {
                HtmlManager.show(this.get());
            }

            static hide() {
                HtmlManager.hide(this.get());
            }

            static init() {
                this.show();
            }

            static setStatus(status) {
                let body = this.get();
                HtmlManager.removeClass(body, "status-" + this.status);
                HtmlManager.addClass(body, "status-" + status);

                switch (status) {
                    case "opened":
                        break;
                    case "importingFile":
                    case "loadingFile":
                        break;
                    case "addingAccount":
                    case "editingAccount":
                        this.addAccountTopButton.hide();
                        break;
                    case "closed":
                        break;
                    default:
                        throw new Error("GdcPageMng.setStatus: Invalid status " + status);
                }

                this.menuBar.setStatus(status);
                this.mainContainer.setStatus(status);
                this.menuBarBottom.setStatus(status);
                this.status = status;
            }

            static open() {
                this.setStatus("opened");
            }

            static close() {
                this.setStatus("closed");
            }

            static reset() {
                this.setStatus("closed");
            }

            static menuBar = class {

                static get() {
                    return HtmlManager.getElementById("containerMenuBar");
                }

                static show() {
                    HtmlManager.show(this.get());
                }

                static hide() {
                    HtmlManager.hide(this.get());
                }

                static setStatus(status) {
                    switch (status) {
                        case "opened":
                            this.show();
                            this.saveButton.show();
                            this.addAccountTopButton.show();
                            break;
                        case "importingFile":
                        case "loadingFile":
                            break;
                        case "addingAccount":
                        case "editingAccount":
                            this.addAccountTopButton.hide();
                            break;
                        case "closed":
                            this.hide();
                            this.saveButton.hide();
                            this.addAccountTopButton.hide();
                            break;
                        default:
                            throw new Error("menuBar.setStatus: Invalid status " + status);
                    }
                }

                static countDownField = class {

                    static get() {
                        return HtmlManager.getElementById("fieldCountdown");
                    }

                    static setInStart() {
                        const element = this.get();
                        HtmlManager.removeClass(element, "paused");
                        HtmlManager.addClass(element, "running");
                    }

                    static setInPause() {
                        const element = this.get();
                        HtmlManager.removeClass(element, "running");
                        HtmlManager.addClass(element, "paused");
                    }

                    static input = class {

                        static get() {
                            return HtmlManager.getElementById("txtCountdown");
                        }

                        static get value() {
                            return TimeManager.toSeconds(this.get().value);
                        }
                        static set value(value) {
                            this.get().value = TimeManager.format(value);
                        }

                        // Pierde el foco
                        static blur() {
                            this.get().blur();
                        }
                    }
                }

                static saveButton = class {
                    static get() {
                        return HtmlManager.getElementById("btnSave")
                    }

                    static show() {
                        HtmlManager.show(this.get());
                    }

                    static hide() {
