        class CryptoAESGCM {
            static async getKey(password) {
                const enc = new TextEncoder();
                const keyMaterial = enc.encode(password);
                const keyHash = await crypto.subtle.digest("SHA-256", keyMaterial);
                return crypto.subtle.importKey(
                    "raw",
                    keyHash,
                    { name: "AES-GCM" },
                    false,
                    ["encrypt", "decrypt"]
                );
            }

            static async encrypt(data, password) {
                let result = null;
                if (data) {
                    try {
                        const key = await this.getKey(password);
                        const iv = crypto.getRandomValues(new Uint8Array(12));
                        const enc = new TextEncoder();
                        const encrypted = await crypto.subtle.encrypt({
                            name: "AES-GCM",
                            iv: iv
                        },
                            key,
                            enc.encode(data)
                        );
                        const encryptText = JSON.stringify({
                            iv: Array.from(iv),
                            data: Array.from(new Uint8Array(encrypted)),
                        });
                        result = StringManager.toBase64(encryptText);
                    }
                    catch (error) {
                        const errorMessage = "CryptoAESGCM.encrypt: Error> " + error.message;
                        ConsoleManager.addError(errorMessage);
                        throw new Error(errorMessage);
                    }
                }
                else {
                    result = "";
                }
                return result;
            }

            static async decrypt(encryptedData, password) {
                let result = null;
                if (encryptedData) {
                    try {
                        const encryptedText = StringManager.fromBase64(encryptedData);
                        const { iv, data } = JSON.parse(encryptedText);
                        const key = await this.getKey(password);
                        const decrypted = await crypto.subtle.decrypt(
                            { name: "AES-GCM", iv: new Uint8Array(iv) },
                            key,
                            new Uint8Array(data)
                        );
                        const dec = new TextDecoder();
                        result = dec.decode(decrypted);
                    }
                    catch (error) {
                        const errorMessage = "CryptoAESGCM.decrypt: Error> " + error.message;
                        ConsoleManager.addError(errorMessage);
                        throw new Error(errorMessage);
                    }

                }
                else {
                    result = "";
                }
                return result;
            }
        }

        class CryptoPBKDF2 {
            /**
             * Deriva una clave AES-GCM-256 robusta aplicando 100,000 iteraciones de PBKDF2 + SHA-256
             */
            static async getKey(password, salt) {
                const enc = new TextEncoder();
                const passwordBytes = enc.encode(password);

                // 1. Importar la contraseña como material de clave base
                const baseKey = await crypto.subtle.importKey(
                    "raw",
                    passwordBytes,
                    { name: "PBKDF2" },
                    false,
                    ["deriveKey"]
                );

                // 2. Derivar la clave simétrica final usando el Salt y las iteraciones
                return crypto.subtle.deriveKey(
                    {
                        name: "PBKDF2",
                        salt: salt,
                        iterations: 100000,
                        hash: "SHA-256"
                    },
                    baseKey,
                    { name: "AES-GCM", length: 256 },
                    false,
                    ["encrypt", "decrypt"]
                );
            }

            static async encrypt(data, password) {
                let result = null;
                if (data) {
                    try {
                        // Generar Salt (16 bytes) e IV (12 bytes) aleatorios y seguros
                        const salt = crypto.getRandomValues(new Uint8Array(16));
                        const iv = crypto.getRandomValues(new Uint8Array(12));

                        const key = await this.getKey(password, salt);
                        const enc = new TextEncoder();

                        const encrypted = await crypto.subtle.encrypt(
                            { name: "AES-GCM", iv: iv },
                            key,
                            enc.encode(data)
                        );

                        // Estructurar incluyendo el 'salt' esencial para PBKDF2
                        const encryptText = JSON.stringify({
                            salt: Array.from(salt),
                            iv: Array.from(iv),
                            data: Array.from(new Uint8Array(encrypted)),
                        });
                        result = StringManager.toBase64(encryptText);
                    }
                    catch (error) {
                        const errorMessage = "CryptoPBKDF2.encrypt: Error> " + error.message;
                        ConsoleManager.addError(errorMessage);
                        throw new Error(errorMessage);
                    }
                }
                else {
                    result = "";
                }
                return result;
            }

            static async decrypt(encryptedData, password) {

                let result = null;
                if (encryptedData) {
                    try {
                        const encryptedText = StringManager.fromBase64(encryptedData);
                        const { salt, iv, data } = JSON.parse(encryptedText);

                        // Recuperar el Salt e IV en sus formatos nativos
                        const saltBuffer = new Uint8Array(salt);
                        const ivBuffer = new Uint8Array(iv);
                        const dataBuffer = new Uint8Array(data);

                        // Volver a derivar la clave usando el salt exacto del archivo
                        const key = await this.getKey(password, saltBuffer);
                        const decrypted = await crypto.subtle.decrypt(
                            { name: "AES-GCM", iv: ivBuffer },
                            key,
                            dataBuffer
                        );

                        const dec = new TextDecoder();
                        result = dec.decode(decrypted);
                    }
                    catch (error) {
                        const errorMessage = "CryptoPBKDF2.decrypt: Error> " + error.message;
                        ConsoleManager.addError(errorMessage);
                        throw new Error(errorMessage);
                    }
                }
                else {
                    result = "";
                }
                return result;
            }

            // static async decrypt(encryptedData, password) {
            //     let result = null;
            //     if (encryptedData) {
            //         try {
            //             // 1. Decodificar Base64 original
            //             const encryptedText = StringManager.fromBase64(encryptedData);

            //             // 2. Intentar parsear el JSON de manera segura
            //             let parsed;
