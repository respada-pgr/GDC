        class GdcCryptoMng {
            static #obfuscationKey = null;
            static #encryptionKey = null;
            static #method = null;
            static #encryptMethods = ["PBKDF2", "AES-GCM"];

            static get encryptionKey() {
                return StringManager.decrypt(this.#encryptionKey, this.#obfuscationKey);;
            }

            static set encryptionKey(value) {
                this.#encryptionKey = StringManager.encrypt(value, this.#obfuscationKey);
            }

            static get isInitialized() {
                return this.#obfuscationKey && this.#method;
            }

            static init(obfuscationKey, method = "PBKDF2") {
                if (method && !this.#encryptMethods.includes(method)) {
                    throw new Error(`GdcCryptoMng.init: Unsupported encryption method "${method}". Supported methods are: ${this.#encryptMethods.join(", ")}`);
                }
                this.#method = method;
                this.#obfuscationKey = obfuscationKey;
            }

            static async encrypt(text) {
                let result = null;
                try {
                    if (!this.isInitialized) {
                        throw new Error("GdcCryptoMng.encrypt: GdcCryptoMng is not initialized. Please call GdcCryptoMng.init() before using encryption methods.");
                    }
                    if (!this.#encryptionKey) {
                        throw new Error("GdcCryptoMng.encrypt: GdcCryptoMng key is not set. Please call GdcCryptoMng.key = <key> before using encryption methods.");
                    }
                    switch (this.#method) {
                        case "PBKDF2":
                            result = await CryptoPBKDF2.encrypt(text, this.encryptionKey);
                            break;
                        case "AES-GCM":
                            result = await CryptoAESGCM.encrypt(text, this.#encryptionKey);
                            break;
                        default:
                            throw new Error(`GdcCryptoMng.encrypt: Unsupported encryption method "${this.#method}".`);
                    }
                }
                catch (error) {
                    const errorMessage = "GdcCryptoMng.encryptText: " + error.message;
                    ConsoleManager.addError(errorMessage);
                    AlertManager.showException(errorMessage);
                }
                return result;
            }

            static async decrypt(text) {
                try {
                    return await CryptoPBKDF2.decrypt(text, this.encryptionKey);
                } catch (error) {
                    try {
                        const legacyDecrypted = await CryptoAESGCM.decrypt(text, this.encryptionKey);

                        ConsoleManager.addLog("GdcCryptoMng.decrypt: Notice: This file contains an older format that has been decrypted. It will be updated to the new standard upon saving.");
                        return legacyDecrypted;
                    } catch (legacyError) {
                        const errorMessage = `GdcCryptoMng.decrypt: Error decrypting with both methods. The file may be corrupted or the password is incorrect.\nError:${legacyError.message}`;
                        ConsoleManager.addError(errorMessage);
                        AlertManager.showException(errorMessage);
                        return null; // Buena práctica devolver null si no se pudo descifrar de ninguna forma
                    }
                }
            }
        }

        class GdcLocalStorageMng {

            static #versionKey = "gdcVersion";

            static get appVersion() {
                let result = null;
                const storedValue = sessionStorage.getItem(this.#versionKey);
                if (storedValue) {
                    result = parseInt(storedValue, 10);
                }
                return result;
            }

            static set appVersion(value) {
                sessionStorage.setItem(this.#versionKey, value);
            }

            static get isInitialized() {
                return this.appVersion !== null;
            }

            static init(version, maxAttempts) {
                if (version === undefined || version === null) {
                    throw new Error("GdcSessionStorageMng.init: version is required");
                }

                if (this.appVersion !== version) {
                    this.remove();
                    this.appVersion = version;
                }

                this.validatePasswordAttempt.init(maxAttempts);
                this.accountData.init();
            }

            static close() {
                this.validatePasswordAttempt.reset();
            }

            static reset() {
                this.validatePasswordAttempt.reset();
                this.accountData.remove();
            }

            static remove() {
                this.validatePasswordAttempt.remove();
                this.accountData.remove();
                sessionStorage.removeItem(this.#versionKey);
            }

            static validatePasswordAttempt = class {

                static key = "gdcAttemptValidatePassword";

                static #maxAttempts = -1;

                static get value() {
                    const attemptStr = localStorage.getItem(this.key);
                    if (attemptStr) {
                        return parseInt(attemptStr, 10);
                    }

                    this.value = this.#maxAttempts;
                    return this.#maxAttempts;
                }

                static set value(value) {
                    localStorage.setItem(this.key, value);
                }

                static init(maxAttempts) {
                    if (maxAttempts === undefined || maxAttempts === null || maxAttempts === "") {
                        throw new Error("GdcLocalStorageMng.validatePasswordAttempt.init: maxAttempts is required");
                    }

                    const parsed = parseInt(maxAttempts, 10);
                    if (isNaN(parsed) || parsed <= 0) {
                        throw new Error("GdcLocalStorageMng.validatePasswordAttempt.init: maxAttempts must be a positive integer and not zero");
                    }
                    this.#maxAttempts = parsed;
                }

                static decrease() {
                    let result = this.#maxAttempts;
                    const attemptStr = this.value;
                    if (attemptStr)
                        result = parseInt(attemptStr);

                    if (result > 0)
                        result--;

                    this.set(result);

                    ConsoleManager.addLog("GdcLocalStorageMng.validatePasswordAttempt.decrease: " + result);
                    return result;
                }

                static reset() {
                    let result = this.#maxAttempts;
                    this.value = result;
                    ConsoleManager.addLog("GdcLocalStorageMng.validatePasswordAttempt.reset: " + result);
                    return result;
                }

                static remove() {
                    localStorage.removeItem(this.key);
                }
            };

            static accountData = class {

                static key = "gdcTableData";

                static async get() {
                    try {
                        let text = localStorage.getItem(this.key);
                        console.log("GdcLocalStorageMng.accountData.get: GdcCryptoMng.decrypt.");
                        text = await GdcCryptoMng.decrypt(text);
                        const json = JSON.parse(text);
                        return json;
                    }
                    catch (error) {
                        const errorMessage = "GdcLocalStorageMng.accountData.get: Error getting or decrypting account data from local storage: " + error.message;
                        ConsoleManager.addError(errorMessage);
                        AlertManager.showException(errorMessage);
                        return null;
                    }
                }

                static async set(json) {
                    const encryptedData = await GdcCryptoMng.encrypt(json);
                    localStorage.setItem(this.key, encryptedData);
                }

                static exists() {
                    return this.get() ? true : false;
                }

                static init() {
                    //
                }

                static remove() {
                    localStorage.removeItem(this.key);
                }
            };
        }

        class GdcSessionStorageMng {

            static #versionKey = "gdcVersion";

            static get appVersion() {
                let result = null;
                const storedValue = sessionStorage.getItem(this.#versionKey);
                if (storedValue) {
                    result = parseInt(storedValue, 10);
                }
                return result;
            }

            static set appVersion(value) {
                sessionStorage.setItem(this.#versionKey, value);
            }

            static get isInitialized() {
                return this.appVersion !== null;
            }

            static init(version, defaultSessionTimeLeft, sessionKey) {
                if (version === undefined || version === null) {
                    throw new Error("GdcSessionStorageMng.init: version is required");
                }

                if (this.appVersion !== version) {
                    this.remove();
                    this.appVersion = version;
                }

                this.sessionKey.init(sessionKey);
                this.sessionTimeLeft.init(defaultSessionTimeLeft);
            }

            static reset() {
                this.sessionTimeLeft.reset();
            }

            static remove() {
                this.sessionTimeLeft.remove();
                sessionStorage.removeItem(this.#versionKey);
            }

            static sessionKey = class {

                static #valueKey = "gdcSessionKey";

                static get value() {
                    return sessionStorage.getItem(this.#valueKey);
                }

                static set value(value) {
                    sessionStorage.setItem(this.#valueKey, value);
                }

                static get isInitialized() {
                    return this.value !== null;
                }

                static init(sessionKey) {
                    if (!sessionKey) {
                        throw new Error("GdcSessionStorageMng.sessionTimeLeft.init: sessionKey is required");
                    }
                    this.value = sessionKey;
                }

                static remove() {
                    sessionStorage.removeItem(this.#valueKey);
                }
            };

            static sessionTimeLeft = class {

                static #defaultValueKey = "gdcDefaultTimeLeft";
                static #timeLeftKey = "gdcTimeLeft";

                // Devuelve el valor en segundos
                static get defaultValue() {
                    let result = null;
                    const defaultStoredTime = sessionStorage.getItem(this.#defaultValueKey);
                    if (defaultStoredTime) {
                        result = parseInt(defaultStoredTime, 10); // Buen hábito: añadir la base 10
                    }
                    return result;
                }

                static set defaultValue(value) {
                    sessionStorage.setItem(this.#defaultValueKey, value);
                }

                // Devuelve el valor en segundos
                static get value() {
                    let result = null;
                    const storedValue = sessionStorage.getItem(this.#timeLeftKey);
                    if (storedValue) {
                        result = parseInt(storedValue, 10);
                    }
                    return result;
                }

                static set value(value) {
                    sessionStorage.setItem(this.#timeLeftKey, value);
                }

                static get isInitialized() {
                    return this.defaultValue !== null && this.value !== null;
                }

                static init(defaultValue) {
                    this.value = defaultValue;
                    this.defaultValue = defaultValue;
                }

                static reset() {
                    this.value = this.defaultValue;
                }

                static remove() {
                    sessionStorage.removeItem(this.#timeLeftKey);
                    sessionStorage.removeItem(this.#defaultValueKey);
                }
            };
        }

        class GdcFileMng {
            static prefixFileName = "data_";
            static fileExtension = ".gdc";

            static init(prefix = "data_", extension = ".gdc") {
                this.prefixFileName = prefix;
                this.fileExtension = extension;
            }

            static async load() {
                const fileInput = GdcPageMng.mainContainer.mainMenu.loadFileInput.get();
                const file = fileInput.files[0];
                if (!file) return null; // Devolvemos null si no hay archivo

                // 1. Retornamos una nueva Promesa para controlar el flujo asíncrono
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();

                    reader.onload = async function (e) {
                        const encryptedData = e.target.result;
                        try {
                            // Desencriptar los datos
                            console.log("GdcFileMng.load: GdcCryptoMng.decrypt.");
                            const decryptedData = await GdcCryptoMng.decrypt(encryptedData);
                            const data = JSON.parse(decryptedData);

                            // 2. ¡Éxito! Resolvemos la promesa devolviendo la data
                            resolve(data);
                        } catch (error) {
                            reject(new Error("GdcFileMng.load: Error decrypting or importing data: " + error.message));
                        }
                    };

                    // Manejar errores de lectura del archivo físico (ej. archivo dañado)
                    reader.onerror = function (error) {
                        reject(new Error("GdcFileMng.load: Error reading physical file: " + error));
                    };

                    reader.readAsText(file);
                });
            }

            static async save(text) {
                if (!text) {
                    throw new Error("GdcFileMng.save: No text provided to save.");
                }
                try {
                    const fileName = this.prefixFileName + DateManager.getFormattedCurrentDateString() + this.fileExtension;
                    text = await GdcCryptoMng.encrypt(text);
                    const blob = new Blob([text], { type: "application/plain" }); // Crear un blob con el texto a guardar

                    // Crear un enlace para descargar el archivo
                    const a = document.createElement("a");
                    a.href = URL.createObjectURL(blob);
                    a.download = fileName;
                    document.body.appendChild(a);
                    //Hace click en el enlace creado
                    a.click();
                    //Elimina el enlace creado
                    document.body.removeChild(a);

                    ConsoleManager.addLog("GdcFileMng.save: Account file saved successfully: " + fileName);
                    return fileName;
                }
                catch (error) {
                    throw new Error("GdcFileMng.save: Error to save text to file: " + error.message);
                }
            }
        }

        class GdcCountDownCtrlMng {

            static #timeLeft = -1;
            static #running = false;
            static #countdownInterval = null;

            static get defaultTimeLeft() {
                return GdcSessionStorageMng.sessionTimeLeft.defaultValue ?? 0;
            }

            static set defaultTimeLeft(newTimeInSeconds) {
                GdcSessionStorageMng.sessionTimeLeft.defaultValue = newTimeInSeconds ?? 0;
            }

            static get timeLeft() {
                return this.#timeLeft;
            }

            static set timeLeft(newTimeInSeconds) {
                GdcPageMng.menuBar.countDownField.input.value = newTimeInSeconds;
                this.#timeLeft = newTimeInSeconds;
            }

            static get isRunning() {
                return this.#running;
            }

            static async init() {
                this.#timeLeft = this.defaultTimeLeft;
                if (this.#countdownInterval) {
                    clearInterval(this.#countdownInterval);
                    this.#countdownInterval = null;
                }
                this.#running = false;
            }

            static update() {
                const newTime = GdcPageMng.menuBar.countDownField.input.value;
                if (newTime !== null && newTime >= 0) {
                    this.defaultTimeLeft = newTime;
                    this.#timeLeft = newTime;
                } else {
                    AlertManager.showWarning("Formato inválido. Por favor, usa hh:mm:ss");
                    //GdcCountDownCtrlMng.setTimeFieldLeft(timeLeft);
                }
            }

            static async start() {
                clearInterval(this.#countdownInterval);
                this.#countdownInterval = setInterval(handleCountDownUpdate, 1000);
                this.#running = true;
                GdcPageMng.menuBar.countDownField.setInStart();
            }

            static pause() {
                clearInterval(this.#countdownInterval);
                this.#countdownInterval = null;
                this.#running = false;
                GdcPageMng.menuBar.countDownField.setInPause();
            }

            static reset(start = false) {
                const wasRunning = this.isRunning;
                this.init();
                if (start || wasRunning) {
                    this.start();
                }
            }

            static end() {
                this.pause();
                this.#timeLeft = -1;
            }
        }

        class GdcSessionMng {

            static get isInitialized() {
                return GdcCryptoMng.key === null;
            }

            static get isLogged() {
                return GdcCryptoMng.key !== null;
            }

            static init() {
                GdcCryptoMng.key = null;
            }

            static async login(password) {
                GdcCryptoMng.encryptionKey = password;
                if (GdcLocalStorageMng.accountData.exists()) {
                    let numAccountsLoaded = await GdcAccountsMng.load();
                    if (numAccountsLoaded != null) {
                        ConsoleManager.addLog("GdcSessionMng.login: Fichero cargado correctamente de memoria. Se han leido " + numAccountsLoaded + " cuentas.")
                        return true;
                    }
                    else {
                        GdcPageMng.mainContainer.mainMenu.newPasswordButton.show();

                        const attempt = await GdcLocalStorageMng.validatePasswordAttempt.decrease();
                        if (attempt < maxAttempts) {
                            if (attempt > 0)
                                AlertManager.showWarning("La contraseña ingresada no es correcta. Intentos restantes: " + attempt);
                            else {
                                GdcPageMng.mainContainer.mainMenu.newPasswordButton.hide();
                                AlertManager.showError("Se ha agotado los intentos para abrir el fichero. Por favor, carga o crea un nuevo fichero.")
                            }
                        }

                        ConsoleManager.addLog("GdcSessionMng.login: La contraseña es incorrecta. Intentos restantes: " + attempt);
                        return false;
                    }
                }
                else {
                    ConsoleManager.addLog("GdcSessionMng.login: No hay cuentas almacenadas en local storage")
                    return true;
                }
            }

            static logout() {
                GdcCryptoMng.key = null;
            }
        }

        class GdcAccountsMng {

            static #idCounter = -1;
            static #edited = false;
            static #pendingToSaveFile = false;

            static get edited() {
                return this.#edited;
            }

            static get pendingToSaveFile() {
                return this.#pendingToSaveFile;
            }

            static getNewIndex() {
                return ++this.#idCounter;
            }

            static setEdited() {
                this.#edited = true;
                this.#pendingToSaveFile = true;
            }

            static get isInitialized() {
                return this.#idCounter !== -1;
            }

            static async init() {
                this.#idCounter = 1;
                this.#edited = false;
                this.#pendingToSaveFile = false;
            }

            static loadJson(dataJson) {
                let idMax = GdcPageMng.mainContainer.mainTable.load(dataJson);
                this.#idCounter = (idMax ?? 0) + 1;
                this.#edited = false;
                this.#pendingToSaveFile = false;
                return dataJson.length;
            }

            static async saveJson(dataJson) {
                await GdcLocalStorageMng.accountData.set(dataJson);
                this.#edited = false;
                return dataJson.length;
            }

            static async load() {
                let numloaded = 0;
                const dataJson = await GdcLocalStorageMng.accountData.get();
                if (dataJson) {
                    numloaded = this.loadJson(dataJson);
                }
                ConsoleManager.addLog("GdcAccountsMng.load: Accounts loaded from local storage successfully: " + numloaded);
                return numloaded;
            }

            static async save() {
                let numSaved = 0;
                const dataJson = GdcPageMng.mainContainer.mainTable.dataRows.getJsonData();
                if (dataJson) {
                    numSaved = await this.saveJson(dataJson);
                }
                ConsoleManager.addLog("GdcAccountsMng.save: Accounts saved into local storage successfully: " + numSaved);
                return numSaved;
            }

            static async loadFromFile() {
                try {
                    const numloaded = 0;
                    const dataJson = await GdcFileMng.load();
                    if (this.#pendingToSaveFile && ConfirmManager.confirm("Hay cambios pendientes de guardar. ¿Desea guardarlos ahora?")) {
                        const numSaved = await this.saveJson(dataJson);
                        ConsoleManager.addLog("GdcAccountsMng.load: Saved pending changes to local storage: " + numSaved);
                    }

                    if (dataJson) {
                        await GdcLocalStorageMng.accountData.set(dataJson);
                        numloaded = this.loadJson(dataJson);
                        ConsoleManager.addLog("GdcAccountsMng.loadFromFile: Accounts loaded from file successfully: " + numloaded);
                    }
                    return numloaded;
                } catch (error) {
                    throw new Error("GdcAccountsMng.loadFromFile: Error loading accounts from file: " + error.message);
                }
            }

            static async saveToFile() {
                try {
                    const dataJson = GdcPageMng.mainContainer.mainTable.dataRows.getJsonData();
                    const fileName = GdcFileMng.save(dataJson);
                    if (fileName) {
                        ConsoleManager.addLog("GdcAccountsMng.save: Accounts saved to file successfully: " + fileName);
                        this.#pendingToSaveFile = false;
                    }
                    return fileName;
                } catch (error) {
                    throw new Error("GdcAccountsMng.saveToFile: Error saving accounts to file: " + error.message);
                }
            }

            static async reset() {
                if (!this.isInitialized) {
                    throw new Error("GdcAccountsMng.reset: The manager is not initialized.");
                }

                if (ConfirmManager.confirm("Los datos actuales se van a borrar ¿Desea guardar una copia en fichero encriptado con la contraseña antigua?")) {
                    const fileName = await this.saveToFile();
                    ConsoleManager.addLog("GdcAccountsMng.reset: Saved old table data to file with old password: " + fileName);
                    AlertManager.showSuccess("Se ha guardado una copia con la antigua contraseña en: " + fileName);
                };

                GdcLocalStorageMng.reset();
                this.#idCounter = 1;
                this.#edited = false;
                this.#pendingToSaveFile = false;
                //this.#selectedRow = null;
            }

            static async close() {
                if (this.#edited || this.#pendingToSaveFile) {
                    const dataJson = GdcPageMng.mainContainer.mainTable.dataRows.getJsonData();

                    if (this.#edited) {
                        await GdcLocalStorageMng.accountData.set(dataJson);
                        this.#edited = false;
                        ConsoleManager.addLog("GdcAccountsMng.close: Accounts saved into local storage successfully!");
                    }

                    if (this.#pendingToSaveFile &&
                        (GdcPageMng.mainContainer.mainMenu.autosaveField.checkbox.isChecked ||
                            ConfirmManager.confirm("Se han modificado los datos de las cuentas. ¿Desea guardarlos en un archivo?")
                        )) {

                        const dataJson = GdcPageMng.mainContainer.mainTable.dataRows.getJsonData();
                        const fileName = GdcFileMng.save(dataJson);
                        if (fileName) {
                            ConsoleManager.addLog("GdcAccountsMng.close: Accounts saved to file successfully: " + fileName);
                            this.#pendingToSaveFile = false;
                        }
                    }
                }

                GdcPageMng.mainContainer.mainTable.close();

                this.#idCounter = 1;
                this.#edited = false;
            }
        }

        class GdcAppMng {

            static #status = "";

            static get status() {
                return this.#status;
            }

            static setStatus(status) {
                switch (status) {
                    case "opened":
                        GdcPageMng.mainContainer.mainMenu.setStatus("opened");
                        GdcCountDownCtrlMng.reset(true);
                        break;
                    case "importingFile":
                        GdcCountDownCtrlMng.end(true);
                        GdcPageMng.mainContainer.mainMenu.setStatus("importingFile");
                        break;
                    case "loadingFile":
                        GdcCountDownCtrlMng.end(true);
                        GdcPageMng.mainContainer.mainMenu.setStatus("loadingFile");
                        break;
                    case "addingAccount":
                        GdcCountDownCtrlMng.reset(true);
                        GdcPageMng.mainContainer.mainMenu.setStatus("addingAccount");
                        break;
                    case "editingAccount":
                        GdcCountDownCtrlMng.reset(true);
                        break;
                    case "closed":
                        GdcCountDownCtrlMng.end(true);
                        GdcPageMng.close();
                        break;
                    default:
                        ConsoleManager.addError("GdcAppMng.setStatus: Unsupported status: " + status);
                }
                this.#status = status;
            }

            static init(appVersion, defaultSessionTimeLeft, maxAttempts, sessionKey, encryptionMethod) {
                GdcCryptoMng.init(sessionKey, encryptionMethod);
                GdcSessionStorageMng.init(appVersion, defaultSessionTimeLeft, sessionKey);
                GdcLocalStorageMng.init(appVersion, maxAttempts);
                GdcPageMng.init();
                GdcFileMng.init();
                GdcSessionMng.init();
                GdcAccountsMng.init();
                GdcCountDownCtrlMng.init();

                if (GdcLocalStorageMng.accountData.exists()) {
                    const attempt = await GdcLocalStorageMng.validatePasswordAttempt.value;
                    if (attempt < maxAttempts) {
                        if (attempt > 0)
                            AlertManager.showMessage("Solo quedan " + attempt + " intentos para desencriptar el fichero");
                        else {
                            GdcPageMng.mainContainer.mainMenu.passwordField.hide();
                            AlertManager.showMessage("Se ha agotado los intentos para abrir el fichero. Por favor, carga o crea un nuevo fichero.")
                        }
                    }
                }
                else {
                    document.getElementById("btnNewDecryptPassword").classList.add("hidden");
                }

                this.setStatus("closed");
            }
        }

        async function handleCloseForm() {
            try {
                if (GdcAccountsMng.edited) {
                    await GdcAccountsMng.save();
                    if (ConfirmManager.confirm("Se han modificado los datos de las cuentas. ¿Desea guardarlos en un archivo?")) {
                        await GdcAccountsMng.saveToFile();
                    }
                }
                await GdcAccountsMng.close();
                GdcSessionMng.logout();
                GdcLocalStorageMng.close();
                GdcAppMng.setStatus("closed");
            }
            catch (error) {
                ConsoleManager.addError("handleCloseForm: Error closing session: " + error.message);
                AlertManager.showException("Error al cerrar la sesión: " + error.message);
            }
        }

        function handleTogglePasswordFieldClick() {
            GdcPageMng.mainContainer.mainMenu.passwordField.togglePassword();
            GdcCountDownCtrlMng.reset();
        }

        async function handleNextClick(event) {

            const elementoClikeado = event.target;
            console.log("handleNextClick: Se hizo clic exactamente en:", elementoClikeado);
            console.log("handleNextClick: ID del elemento:", elementoClikeado.id);
            console.log("handleNextClick: Clases del elemento:", elementoClikeado.className);

            if (GdcAppMng.status == "importingFile") {
                GdcAppMng.setStatus("loadingFile");
            }
            else {
                try {
                    const result = await GdcSessionMng.login(GdcPageMng.mainContainer.mainMenu.passwordField.input.value);
                    if (result) {
                        GdcAppMng.setStatus("opened");
                    }
                    else {
                        await handleCloseForm();
                    }
                } catch (error) {
                    ConsoleManager.addError("handleNextClick: Error during login: " + error.message);
                    AlertManager.showException("Error durante el inicio de sesión: " + error.message);
                }
            }
        }

        async function handleDecryptPasswordInputKeypress(event) {
            if (event.key === "Enter") {
                await handleNextClick(event);
            }
        }

        async function handleNewButtonClick() {
            if (ConfirmManager.confirm("Se van a borrar todas las contraseñas ¿Estás seguro de continuar?")) {
                try {
                    await GdcAccountsMng.reset();
                    GdcSessionMng.logout();
                    GdcLocalStorageMng.reset();
                    GdcAppMng.setStatus("closed");

                    AlertManager.showException("Creado un nuevo fichero de gestión de cuentas! Por favor, introduzca la contraseña de desencriptación.");
                }
                catch (error) {
                    ConsoleManager.addError("handleNewButtonClick: Error creating new accounts file: " + error.message);
                    AlertManager.showException("Error al crear un nuevo fichero de cuentas: " + error.message);
                }
            };
        }

        async function handleChangeDecryptPasswordClick() {
            if (ConfirmManager.confirm("¿Estás seguro de cambiar la contraseña?")) {

                const newPass = GdcPageMng.mainContainer.mainMenu.passwordField.input.value;
                if (newPass == GdcCryptoMng.encryptionKey) {
                    AlertManager.showError("La nueva contraseña no es valida");
                } else {
                    try {
                        //const fileName = await GdcAccountsMng.saveToFile();
                        //ConsoleManager.addLog("handleChangeDecryptPasswordClick: Saved old table data to file: " + fileName);
                        //AlertManager.showSuccess("Se ha guardado una copia con la antigua contraseña en: " + fileName);

                        GdcCryptoMng.encryptionKey = newPass;

                        await GdcAccountsMng.save();
                        ConsoleManager.addLog("handleChangeDecryptPasswordClick: New table saved into local storage successfully!");

                        const fileName = await GdcAccountsMng.saveToFile();
                        ConsoleManager.addLog("handleChangeDecryptPasswordClick: Accounts saved to file successfully: " + fileName);

                        await handleCloseForm();

                        AlertManager.showSuccess("Contraseña cambiada correctamente! Por favor, introduzca la nueva contraseña de desencriptación.");
                    }
                    catch (error) {
                        ConsoleManager.addError("handleChangeDecryptPasswordClick: Error changing password: " + error.message);
                        AlertManager.showException("Error al cambiar la contraseña: " + error.message);
                    }
                }
            }
        }

        // Load File Handlers
        function handleLoadButtonClick() {
            if (ConfirmManager.confirm("Se va ha importar un fichero de contraseñas nuevo ¿Estás seguro de continuar?")) {
                GdcAppMng.setStatus("importingFile");
                AlertManager.showSuccess("Fichero cargado correctamente. Por favor, introduzca la contraseña de desencriptación del nuevo fichero.");
            }
        }

        async function handleLoadFileInput() {
            if (GdcAppMng.status == "loadingFile") {
                if (ConfirmManager.confirm("Se va a cargar un fichero nuevo ¿Está seguro que quiere continuar?")) {
                    try {
                        const numLoaded = await GdcAccountsMng.loadFromFile();
                        if (numLoaded != null) {
                            GdcAppMng.setStatus("opened");
                            ConsoleManager.addLog("handleLoadFileInput: File loaded successfully with " + numLoaded + " accounts.");
                            AlertManager.showSuccess(`Se han cargado correctamente ${numLoaded} cuentas.`);
                        }
                        else {
                            GdcAppMng.setStatus("closed");
                            ConsoleManager.addLog("handleLoadFileInput: No accounts loaded from file.");
                            AlertManager.showWarning("No se ha encontrado ninguna cuenta en el fichero.");
                        }
                    }
                    catch (error) {
                        ConsoleManager.addError("handleLoadFileInput: Error loading file: " + error.message);
                        AlertManager.showException("Error al cargar el fichero: " + error.message);
                    }
                }
            }
            else {
                ConsoleManager.addError("handleLoadFileInput: Invalid status: " + GdcAppMng.status);
                AlertManager.showError("Error al cargar el fichero: Estado incorrecto: " + GdcAppMng.status);
            }
        }

        async function handleSaveAccountsToFileButtonClick() {
            try {
                const fileName = await GdcAccountsMng.saveToFile();
                if (fileName) {
                    ConsoleManager.addLog("handleSaveAccountsToFileButtonClick: Accounts saved to file successfully: " + fileName);
                    AlertManager.showSuccess("Se han guardado las cuentas en el fichero: " + fileName);
                }
            }
            catch (error) {
                ConsoleManager.addError("handleSaveAccountsToFileButtonClick: Error saving accounts to file: " + error.message);
                AlertManager.showException("Error al guardar las cuentas en el fichero: " + error.message);
            }
        }

        // Countdown Manager Handlers
        function handleStartButtonClick() {
            GdcCountDownCtrlMng.start(); // Reanudar el temporizador
        }

        function handlePauseButtonClick() {
            GdcCountDownCtrlMng.pause(); // Llamar a la nueva función para pausar el temporizador
        }

        function handleResetButtonClick() {
            GdcCountDownCtrlMng.reset(); // Reiniciar el temporizador solo si estaba corriendo
        }

        function handleCountdownInputFocus() {
            GdcCountDownCtrlMng.pause(); // Llamar a la nueva función para pausar el temporizador
        }

        function handleCountdownInputChange() {
            GdcCountDownCtrlMng.update();
        }

        function handleCountdownInputKeypress(event) {
            if (event.key === "Enter") {
                GdcPageMng.menuBar.countDownField.input.blur(); // Pierde el foco
                GdcCountDownCtrlMng.start();
            }
        }

        async function handleCountDownUpdate() {
            let timeLeft = GdcCountDownCtrlMng.timeLeft;
            if (timeLeft > 0) {
                GdcCountDownCtrlMng.timeLeft = --timeLeft;
            } else {
                //AlertManager.showMessage('El tiempo ha terminado');
                await handleCloseForm();
            }
        }

        // Table Handlers
        function handleAddAcountButtonClick() {
            GdcPageMng.mainContainer.mainTable.newDataRow();
            GdcAppMng.setStatus("addingAccount");
        }

        async function handleMoveRowUpButtonClick() {
            if (GdcPageMng.mainContainer.mainTable.dataRows.selectedRow.moveUp()) {
                await GdcAccountsMng.save();
            }
            GdcCountDownCtrlMng.reset();
        }

        async function handleMoveRowDownButtonClick() {
            if (GdcPageMng.mainContainer.mainTable.dataRows.selectedRow.moveDown()) {
                await GdcAccountsMng.save();
            }
            GdcCountDownCtrlMng.reset();
        }

        async function handleTableClick(event) {
            GdcCountDownCtrlMng.reset();

            let control = event.target;
            let editingRow = control.closest("tr");

            //Remove row
            if (HtmlManager.containsClass(control, "delete")) {

                const userConfirmed = ConfirmManager.confirm("¿Estás seguro de que deseas borrar el registro?");
                if (userConfirmed) {
                    editingRow.remove();
                    try {
                        await GdcAccountsMng.save();
                    }
                    catch (error) {
                        ConsoleManager.addError("handleTableClick: Error removing accounts: " + error.message);
                        AlertManager.showException("Error al guardar las cuentas: " + error.message);
                    }
                }

            } //Edit row
            else if (HtmlManager.containsClass(control, "edit")) {
                const data = GdcPageMng.mainContainer.mainTable.dataRows.dataRow.getData(editingRow);
                GdcPageMng.mainContainer.mainTable.editRow.fill(data);
                HtmlManager.hide(editingRow); // Hide editing row;
                GdcPageMng.mainContainer.mainTable.insertDataRow(editingRow);
                GdcPageMng.setStatus("editingAccount");
            } //Toggle password
            else if (HtmlManager.containsClass(control, "btnTogglePassword")) {
                const passwordField = control.previousElementSibling;
                if (passwordField.type === "password") {
                    passwordField.type = "text";
                    if (passwordField.dataset.encrypted) {
                        console.log("handleTableClick: GdcCryptoMng.decrypt.");
                        passwordField.value = await GdcCryptoMng.decrypt(
                            passwordField.dataset.encrypted
                        );
                    }
                    control.textContent = "🙈"; // Cambia el icono

                    // Iniciar contador de 15 segundos para ocultar la contraseña
                    setTimeout(() => {
                        if (passwordField.type === "text") {
                            passwordField.type = "password";
                            if (passwordField.dataset.encrypted)
                                passwordField.value = StringManager.maskText(passwordField.value);
                            control.textContent = "👁️"; // Vuelve al icono original
                        }
                    }, 15000); // 15000 milisegundos = 15 segundos
                } else {
                    passwordField.type = "password";
                    if (passwordField.dataset.encrypted)
                        passwordField.value = StringManager.maskText(passwordField.value);
                    control.textContent = "👁️"; // Vuelve al icono original
                }
            }

            GdcPageMng.mainContainer.mainTable.dataRows.selectedRow.set(editingRow);
        }

        async function handleSaveAccountButtonClick() {
            GdcCountDownCtrlMng.reset();
            const rowData = GdcPageMng.mainContainer.mainTable.editRow.getData();
            const originalRow = GdcPageMng.mainContainer.mainTable.dataRows.dataRow.getById(rowData.id);
            if (originalRow) {
                const editedRow = GdcPageMng.mainContainer.mainTable.dataRows.dataRow.create(rowData);
                GdcPageMng.mainContainer.mainTable.replaceDataRow(editedRow, originalRow);
            } else {
                rowData.id = GdcAccountsMng.getNewIndex();
                GdcPageMng.mainContainer.mainTable.addAccount(rowData);
            }

            try {
                await GdcAccountsMng.save();
            }
            catch (error) {
                ConsoleManager.addError("handleSaveAccountButtonClick: Error saving accounts: " + error.message);
                AlertManager.showException("Error al guardar las cuentas: " + error.message);
            }

            GdcPageMng.mainContainer.mainTable.recreateEditRow();
            GdcPageMng.setStatus("opened");
        }

        function handleCancelEditAcoountButtonClick() {
            GdcCountDownCtrlMng.reset();
            GdcPageMng.mainContainer.mainTable.editRow.showOriginal();
            GdcPageMng.mainContainer.mainTable.recreateEditRow();
            GdcPageMng.setStatus("opened");
        }

        // App Initialization
        const APP_VERSION = "1.0.0";
        const DEFAULT_SESSION_TIME_LEFT = 300; // 5 minutes in seconds
        const MAX_ATTEMPTS = 5;
        const ENCRYPTION_METHOD = "PBKDF2";

        async function init() {

            GdcAppMng.init(
                APP_VERSION,
                DEFAULT_SESSION_TIME_LEFT,
                MAX_ATTEMPTS,
                StringManager.generatePassword(8),
                ENCRYPTION_METHOD
            );

            if (GdcLocalStorageMng.accountData.exists()) {
                const attempt = await GdcLocalStorageMng.validatePasswordAttempt.value;
                if (attempt < maxAttempts) {
                    if (attempt > 0)
                        AlertManager.showMessage("Solo quedan " + attempt + " intentos para desencriptar el fichero");
                    else {
                        GdcPageMng.mainContainer.mainMenu.passwordField.hide();
                        AlertManager.showMessage("Se ha agotado los intentos para abrir el fichero. Por favor, carga o crea un nuevo fichero.")
                    }
                }
            }
            else {
                document.getElementById("btnNewDecryptPassword").classList.add("hidden");
            }
        }

        function checkLegalAcceptance() {
            //const hasAccepted = localStorage.getItem("gdc_legal_accepted");
            const modal = document.getElementById("legalModal");

            //if (!hasAccepted) {
            modal.style.display = "block";
            //}

            document.getElementById("btnAcceptLegal").onclick = function () {
                //localStorage.setItem("gdc_legal_accepted", "true");
                modal.style.display = "none";
                init();
                // Opcional: podrías llamar a init() aquí si quieres que la app no haga nada hasta aceptar
            };
        }

        document.addEventListener("DOMContentLoaded", function () {
            const startButton = document.getElementById("btnStartCountdown");
            startButton.addEventListener("click", handleStartButtonClick);

            const pauseButton = document.getElementById("btnPauseCountdown");
            pauseButton.addEventListener("click", handlePauseButtonClick);

            const resetButton = document.getElementById("btnResetCountdown");
            resetButton.addEventListener("click", handleResetButtonClick);

            const countdownInput = document.getElementById("txtCountdown");
            countdownInput.addEventListener("focus", handleCountdownInputFocus);
            countdownInput.addEventListener("input", handleCountdownInputChange);
            countdownInput.addEventListener("keypress", handleCountdownInputKeypress);

            const passwordInput = GdcPageMng.mainContainer.mainMenu.passwordField.input.get();
            passwordInput.addEventListener("keypress", handleDecryptPasswordInputKeypress);

            const saveDecryptPasswordButton = document.getElementById("btnNext");
            saveDecryptPasswordButton.addEventListener("click", handleNextClick);

            const changeDecryptPasswordButton = document.getElementById("btnChangeDecryptPassword");
            changeDecryptPasswordButton.addEventListener("click", handleChangeDecryptPasswordClick);

            const togglePassword = document.getElementById("btnToggleDecryptPassword");
            togglePassword.addEventListener("click", handleTogglePasswordFieldClick);

            const newButton = document.getElementById("btnNewDecryptPassword");
            newButton.addEventListener("click", handleNewButtonClick);

            const addButton = document.getElementById("btnAddAccount");
            addButton.addEventListener("click", handleAddAcountButtonClick);

            const addButtonTop = document.getElementById("btnAddAccountTop");
            addButtonTop.addEventListener("click", handleAddAcountButtonClick);

            const importButton = document.getElementById("btnLoad");
            importButton.addEventListener("click", handleLoadButtonClick);

            const exportButton = document.getElementById("btnSave");
            exportButton.addEventListener("click", handleSaveAccountsToFileButtonClick);

            const importFileInput = document.getElementById("inputLoadFile");
            importFileInput.addEventListener("change", handleLoadFileInput);

            const moveUpButton = document.getElementById("btnMoveAccountUp");
            moveUpButton.addEventListener("click", handleMoveRowUpButtonClick);

            const moveDownButton = document.getElementById("btnMoveAccountDown");
            moveDownButton.addEventListener("click", handleMoveRowDownButtonClick);

            const tableBody = document.querySelector("#tblMain tbody");
            tableBody.addEventListener("click", handleTableClick);

            const saveButton = document.getElementById("save-button");
            saveButton.addEventListener("click", handleSaveAccountButtonClick);

            const cancelButton = document.getElementById("cancel-button");
            cancelButton.addEventListener("click", handleCancelEditAcoountButtonClick);

            checkLegalAcceptance();
        });
    </script>
</body>

</html>