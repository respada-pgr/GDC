            static mainContainer = class {
                static get() {
                    return HtmlManager.getElementById("containerMain")
                }

                static open() {
                    HtmlManager.addClass(this.get(), "opened");
                    HtmlManager.removeClass(this.get(), "editing")
                }

                static close() {
                    HtmlManager.removeClass(this.get(), "editing")
                    HtmlManager.removeClass(this.get(), "opened");
                }

                static setStatus(status) {
                    switch (status) {
                        case "opened":
                            this.open();
                            break;
                        case "importingFile":
                        case "loadingFile":
                            break;
                        case "addingAccount":
                        case "editingAccount":
                            HtmlManager.addClass(this.get(), "editing");
                            this.mainTable.editRow.show();
                            break;
                        case "closed":
                            this.close();
                            break;
                        default:
                            throw new Error("GdcPageMng.setStatus: Invalid status " + status);
                    }
                    this.mainMenu.setStatus(status);
                    this.mainTable.setStatus(status);
                }

                static mainMenu = class {

                    static open() {
                        this.passwordField.open();
                        this.autosaveField.show();
                        this.newPasswordButton.show();
                        this.loadFileInput.hide();
                        this.loadFileButton.show();
                    }

                    static close() {
                        this.passwordField.close();
                        this.autosaveField.hide();
                        this.newPasswordButton.show();
                        this.loadFileInput.hide();
                        this.loadFileButton.show();
                    }

                    static setStatus(status) {
                        switch (status) {
                            case "opened":
                                this.open();
                                break;
                            case "importingFile":
                                this.autosaveField.hide();
                                this.newPasswordButton.hide();
                                this.loadFileInput.show();
                                this.loadFileButton.hide();
                                break;
                            case "loadingFile":
                                this.passwordField.hide();
                                this.loadFileInput.show();
                                break;
                            case "addingAccount":
                            case "editingAccount":
                                break;
                            case "closed":
                                this.close();
                                break;
