                    static passwordField = class {

                        static get() {
                            return document.getElementById("containerDecryptPassword");
                        }

                        static show() {
                            this.get().classList.remove("hidden");
                        }

                        static hide() {
                            this.get().classList.add("hidden");
                        }

                        static open() {
                            this.show();
                            this.hidePassword();
                            this.changeButton.show();
                            this.nextButton.show();
                        }

                        static close() {
                            this.changeButton.hide();
                            this.nextButton.show();
                            this.clear();
                            this.show();
                        }

                        static clear() {
                            this.input.clear();
                            this.hidePassword();
                        }

                        static showPassword() {
                            this.input.showPassword();
                            this.toggleViewButton.setStatus("showedPassword");

                            // Iniciar contador de 15 segundos para ocultar la contraseña
                            setTimeout(() => {
                                this.hidePassword();
                            }, 15000); // 15000 milisegundos = 15 segundos
                        }

                        static hidePassword() {
                            this.input.hidePassword();
                            this.toggleViewButton.setStatus("hiddenPassword");
                        }

                        static togglePassword() {
                            if (this.input.isVisible) {
                                this.hidePassword();
                            }
                            else {
                                this.showPassword();
                            }
                        }

                        static setStatus(status) {
                            switch (status) {
                                case "opened":
                                    this.open();
                                    break;
                                case "importingFile":
                                    this.nextButton.show();
                                    this.changeButton.hide();
                                    break;
                                case "loadingFile":
                                    this.show();
                                    this.clear();
                                    this.nextButton.show();
                                    this.changeButton.hide();
                                    break;
                                case "addingAccount":
                                case "editingAccount":
                                    this.nextButton.hide();
                                    this.changeButton.hide();
                                    break;
                                case "closed":
                                    this.close();
                                    break;
                                default:
                                    throw new Error("GdcPageMng.mainContainer.mainMenu.passwordField.setStatus: Invalid status " + status);
                            }
                        }

                        static input = class {

                            static get() {
                                return document.getElementById("txtDecryptPassword");
                            }

                            static get isVisible() {
                                return this.get().type === "text";
                            }

                            static showPassword() {
                                this.get().type = "text";
                            }

                            static hidePassword() {
                                this.get().type = "password";
                            }

                            static get value() {
                                return this.get().value;
                            }
                            static set value(value) {
                                this.get().value = value;
                            }

                            static get type() {
                                return this.get().type;
                            }
                            static set type(value) {
                                this.get().type = value;
                            }

                            static clear() {
                                this.get().value = ""; // Limpiar el campo de contraseña
                            }
