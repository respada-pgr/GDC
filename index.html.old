                static mainTable = class {

                    static get() {
                        return HtmlManager.getElementById("tblMain");
                    }

                    static show() {
                        HtmlManager.show(this.get());
                    }

                    static hide() {
                        HtmlManager.hide(this.get());
                    }

                    static clear() {
                        this.dataRows.clear();
                        this.editRow.clear();
                    }

                    static close() {
                        this.hide();
                        this.clear();
                    }

                    static setStatus(status) {
                        switch (status) {
                            case "opened":
                                this.show();
                                break;
                            case "importingFile":
                            case "loadingFile":
                            case "addingAccount":
                            case "editingAccount":
                                break;
                            case "closed":
                                this.close();
                                break;
                            default:
                                throw new Error("GdcPageMng.setStatus: Invalid status " + status);
                        }
                    }

                    static load(dataJson) {
                        try {
                            this.clear();
                            let maxId = 0
                            for (const rowData of dataJson) {
                                const id = Number(rowData.id);
                                this.addAccount(rowData);
                                maxId = id > maxId ? id : maxId;
                            }
                            return maxId;
                        }
                        catch (error) {
                            const errorMessage = "GdcPageMng.mainContainer.mainTable.load: Error loading data. The file may be corrupted or not in the expected format.\nError: " + error.message;
                            //ConsoleManager.addError(errorMessage);
                            AlertManager.showException(errorMessage);
                            throw new Error(errorMessage);
                        }
                    }

                    static newDataRow() {
                        const newRow = this.editRow.get();
                        HtmlManager.addClass(newRow, "new");
                        this.bodyRows.add(newRow);
                        this.dataRows.unselectAll();
                        HtmlManager.show(newRow);
                    }

                    static insertDataRow(row) {
                        const editRow = this.editRow.get();
                        this.bodyRows.insertBefore(row, editRow);
                    }

                    static replaceDataRow(newRow, old) {
                        this.bodyRows.replaceDataRow(row, editRow);
                    }

                    static addAccount(data) {
                        this.insertDataRow(this.dataRows.dataRow.create(data));
                    }

                    static recreateEditRow() {
                        const formRow = this.editRow.get();
                        HtmlManager.removeClass(formRow, "new");
                        HtmlManager.hide(formRow);
                        this.editRow.clear();
                        this.bodyRows.add(formRow);
                    }

                    static bodyRows = class {
                        static get() {
                            return HtmlManager.getElementByQuerySelector("#tblMain tbody");
                        }

                        static add(row) {
                            this.get().appendChild(row);
                        }

                        static insertBefore(newRow, oldRow) {
                            this.get().insertBefore(newRow, oldRow);
                        }

                        static replace(newRow, old) {
                            this.get().replaceChild(newRow, oldRow);
                            //this.insertBefore(newRow, oldRow);
                            //oldRow.remove();
                        }
                    }

                    static dataRows = class {
                        static get() {
                            return document.querySelectorAll("#tblMain .data-row");
                        }

                        static getSelectedRows() {
                            return document.querySelector("#tblMain .data-row.selected");
                        }

                        static getArrayData() {
                            const data = [];
                            this.get().forEach((row) => {
                                const rowData = this.dataRow.getData(row);
                                data.push(rowData);
                            });
                            return data;
                        }

                        static getJsonData() {
                            return JSON.stringify(this.getArrayData());
                        }

                        static unselectAll() {
                            this.get().forEach((row) => {
                                row.classList.remove("selected");
                            });
                        }

                        static clear() {
                            this.get().forEach((row) => {
                                row.remove();
                            });
                        }

                        static selectedRow = class {
                            current = null;

                            static set(row) {
                                if (!row || !row.classList.contains("data-row")) {
                                    throw new Error("GdcPageMng.mainContainer.mainTable.dataRows.selectedRow.set: The provided element is not a valid data row.");
                                }

                                if (this.current) {
                                    this.current.classList.remove("selected");
                                }

                                row.classList.add("selected");
                                this.current = row;
                            }

                            static moveUp() {
                                if (this.current) {
                                    const previousRow = this.current.previousElementSibling;
                                    if (previousRow && previousRow.id !== "form-row") {
                                        this.current.parentNode.insertBefore(this.current, previousRow);
                                        return true;
                                    }
                                }
                                return false;
                            }

                            static moveDown() {
                                if (this.current) {
                                    const nextRow = this.current.nextElementSibling;
                                    if (nextRow && nextRow.id !== "form-row") {
                                        this.current.parentNode.insertBefore(nextRow, this.current);
                                        return true;
                                    }
                                }
                                return false;
                            }

                            static clear() {
                                if (this.current) {
                                    this.current.classList.remove("selected");
                                    this.current = null;
                                }
                            }
                        }

                        static dataRow = class {


                            static getById(id) {
                                return document.querySelector(`#tblMain .data-row[id="${id}"]`);
                            }

                            static show(row) {
                                row.style.display = "table-row";
                            }

                            static hide(row) {
                                row.style.display = "none";
                            }

                            static create(rowData) {
                                const newRow = document.createElement("tr");
                                newRow.id = rowData.id;
                                newRow.classList.add("data-row");
                                newRow.innerHTML = `
                                                                <td class="hidden"><div><span class="field-label">Id:</span><span>${rowData.id}</span></div></td>
                                                                <td class="site-name"><div><span class="field-label">Sitio:</span>${rowData.url ? `<a href="${rowData.url}" target="_blank" title="${rowData.url}"> ${rowData.name} </a>` : ""}</div></td>
                                                                <td><div><span class="field-label" style="min-width: 64px">Usuario:</span><input type="text" value="${rowData.accountUser}" readonly></div></td>
                                                                <td><div style="min-width: 64px"><span class="field-label">Password:</span><input type="password" class="encrypted-password" value="${rowData.accountPassword}" readonly><span class="btnTogglePassword btn-emoji">👁️</span></div></td>
                                                                <td><div><span class="field-label">Notas:</span><span title="${rowData.notes}" style="text-align: justify;">${rowData.notes}</span></div></td>
                                                                <td class="only-laptop"><div><span class="field-label">Creación:</span><span class="date">${rowData.createDate}</span></div></td>
                                                                <td><div><span class="field-label">Actualización:</span><span class="date">${rowData.updateDate}</span></div></td>
                                                                <td>
                                                                    <div class="buttonPanel">
                                                                        <button title="Editar" class="edit">✏️</button>
                                                                        <button title="Eliminar" class="delete red">X</button>
                                                                    </div>
                                                                </td>
                                                                `;
                                return newRow;
                            }

                            static getData(row) {
                                const data = {
                                    id: row.children[0].children[0].children[1].innerText,
                                    name: row.children[1].children[0].children[1].innerText,
                                    url: row.children[1].querySelector("a")
                                        ? row.children[1].children[0].querySelector("a").href
                                        : "",
                                    accountUser: row.children[2].children[0].children[1].value,
                                    accountPassword: row.children[3].children[0].children[1].value,
                                    notes: row.children[4].children[0].children[1].innerText,
                                    createDate: row.children[5].children[0].children[1].innerText,
                                    updateDate: row.children[6].children[0].children[1].innerText,
                                };
                                return data;
                            }
                        }
                    }

                    static editRow = class {
                        static get() {
                            return HtmlManager.getElementById("form-row");
                        }

                        static show() {
                            HtmlManager.show(this.get());
                        }

                        static hide() {
                            HtmlManager.hide(this.get());
                            HtmlManager.removeClass(this.get(), "new");
                            this.clear();
                        }

                        static setStatus(status) {
                            switch (status) {
                                case "show":
                                    this.show();
                                    break;
                                case "hide":
                                    this.hide();
                                    break;
                                case "new":
                                    this.clear();
                                    HtmlManager.show(this.get());
                                    HtmlManager.addClass(this.get(), "new");
                                    break;
                                default:
                                    throw new Error("GdcPageMng.mainContainer.mainTable.editRow.setStatus: Invalid status " + status);
                            }
                        }

                        static getOriginal() {
                            return HtmlManager.getElementById(document.getElementById("f-id").value);
                        }

                        static showOriginal() {
                            const originalRow = this.getOriginal();
                            if (originalRow) {
                                HtmlManager.show(originalRow);
                            }
                        }

                        static getData() {
                            let id = this.get().getElementById("f-id").value;
                            if (!Number.isInteger(parseInt(id))) {
                                id = 0; // Asignar un valor por defecto en caso de que el id no sea un entero
                            }

                            const now = DateManager.getCurrentDateString();
                            const result = {
                                id: id,
                                name: HtmlManager.getElementById("f-name").value,
                                url: URLManager.ensureProtocol(HtmlManager.getElementById("f-url").value),
                                accountUser: HtmlManager.getElementById("f-user").value,
                                accountPassword: HtmlManager.getElementById("f-password").value,
                                notes: HtmlManager.getElementById("f-notes").value,
                                createDate: HtmlManager.getElementById("f-createDate").value || now,
                                updateDate: now
                            };
                            return result;
                        }

                        static fill(data) {
                            HtmlManager.getElementById("f-id").value = data.id;
                            HtmlManager.getElementById("f-name").value = data.name;
                            HtmlManager.getElementById("f-url").value = data.url;
                            HtmlManager.getElementById("f-user").value = data.accountUser;
                            HtmlManager.getElementById("f-password").value = data.accountPassword;
                            HtmlManager.getElementById("f-notes").value = data.notes;
                            HtmlManager.getElementById("f-createDate").value = data.createDate;
                            HtmlManager.getElementById("f-updateDate").value = data.updateDate;
                        }

                        static clear() {
                            HtmlManager.getElementById("f-id").value = "";
                            HtmlManager.getElementById("f-name").value = "";
                            HtmlManager.getElementById("f-url").value = "";
                            HtmlManager.getElementById("f-user").value = "";
                            HtmlManager.getElementById("f-password").value = "";
                            HtmlManager.getElementById("f-notes").value = "";
                            HtmlManager.getElementById("f-createDate").value = "";
                            HtmlManager.getElementById("f-updateDate").value = "";
                        }
                    }
                }
            }

